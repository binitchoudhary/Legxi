  /* ── INIT ── */
  function init() {
    initFirebase();
    initBoxes();

    /* Edition cards — now shown post-auth; clicking goes to products */
    root.querySelectorAll('[data-edition]').forEach(function (el) {
      function selectEdition() {
        S.edition = el.dataset.edition;
        S.orders  = S.allOrders;
        renderProducts();
        go('products');
      }
      el.addEventListener('click', selectEdition);
      el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectEdition(); } });
    });

    /* Send OTP */
    var sendBtn = root.querySelector('#sa-send-otp');
    if (sendBtn) sendBtn.addEventListener('click', handleSend);
    var phoneInp = root.querySelector('#sa-phone-input');
    if (phoneInp) phoneInp.addEventListener('keydown', function (e) { if (e.key === 'Enter') handleSend(); });

    /* Verify OTP */
    var verBtn = root.querySelector('#sa-verify-otp');
    if (verBtn) verBtn.addEventListener('click', handleVerify);

    /* Also verify on Enter in last box */
    var lastBox = root.querySelectorAll('.sa-otp-box');
    if (lastBox.length) {
      lastBox[lastBox.length - 1].addEventListener('keydown', function (e) { if (e.key === 'Enter') handleVerify(); });
    }

    /* Resend */
    var resendBtn = root.querySelector('#sa-resend-btn');
    if (resendBtn) resendBtn.addEventListener('click', function () {
      root.querySelectorAll('.sa-otp-box').forEach(function (b) { b.value = ''; });
      var first = root.querySelector('.sa-otp-box');
      if (first) first.focus();
      sendOTP();
    });

    /* All data-goto buttons */
    root.querySelectorAll('[data-goto]').forEach(function (el) {
      el.addEventListener('click', function () { go(el.dataset.goto); });
    });

    /* Error modal close */
    function closeErrModal() { hideOrderError(); }
    var errClose = root.querySelector('#sa-err-close');
    var errTryBtn = root.querySelector('#sa-err-try-btn');
    var errModal = root.querySelector('#sa-err-modal');
    if (errClose) errClose.addEventListener('click', closeErrModal);
    if (errTryBtn) errTryBtn.addEventListener('click', closeErrModal);
    if (errModal) errModal.addEventListener('click', function(e) { if (e.target === errModal) closeErrModal(); });

    /* First screen is active by default via HTML class (no-JS fallback) */
  }

  init();

})();
</script>

