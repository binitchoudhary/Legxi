            <line x1="32" y1="21" x2="32" y2="16"/>
            <line x1="41.5" y1="27.5" x2="46" y2="24"/>
            <line x1="38" y1="39" x2="45" y2="48"/>
            <line x1="26" y1="39" x2="19" y2="48"/>
            <line x1="22.5" y1="27.5" x2="18" y2="24"/>
            <line x1="40.5" y1="6.5" x2="55" y2="15"/>
            <line x1="23.5" y1="6.5" x2="9" y2="15"/>
            <line x1="40.5" y1="57.5" x2="54" y2="49"/>
            <line x1="23.5" y1="57.5" x2="10" y2="49"/>
            <line x1="60" y1="33" x2="59" y2="59"/>
            <line x1="4" y1="33" x2="5" y2="59"/>
