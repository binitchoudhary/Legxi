<!-- Config (Liquid → JS) -->
<script>
window.SixxerCfg = {
  firebase: {
    apiKey:            '{{ section.settings.firebase_api_key | escape }}',
    authDomain:        '{{ section.settings.firebase_auth_domain | escape }}',
    projectId:         '{{ section.settings.firebase_project_id | escape }}',
    appId:             '{{ section.settings.firebase_app_id | escape }}',
    messagingSenderId: '{{ section.settings.firebase_messaging_sender_id | escape }}'
  },
  shopify: {
    storefrontToken: '{{ section.settings.storefront_token | escape }}',
    appProxyUrl:     '{{ section.settings.app_proxy_url | default: "" | escape }}',
    domain:          '{{ shop.permanent_domain | escape }}',
    transferApiUrl:  '{{ section.settings.transfer_api_url | default: "" | escape }}'
  }
};
</script>

<!-- Firebase Compat SDKs -->
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>

<script>
/* ==========================================================
   SIXXER AUTH — MAIN APPLICATION
   Flow: Edition → Phone → OTP → Products → Certificate
   Auth: Firebase Phone OTP → Shopify App Proxy → Storefront API
   PDF: jsPDF only (pure drawing — no html2canvas)
========================================================== */
(function () {
  'use strict';

  var root = document.getElementById('sa-root');
  if (!root) return;

  var cfg = window.SixxerCfg || {};

  /* ── STATE ── */
  var S = {
    edition:            null,
    countryCode:        '+91',
    phone:              null,
    confirmResult:      null,
    fbUser:             null,
    custToken:          null,
    customer:           null,
    orders:             [],
    allOrders:          [],
    availableEditions:  [],
    activeCert:         null,
    resendTimer:        null,
    resendSecs:         30,
    currentScreen:      'phone'
  };

  /* ── SCREEN NAVIGATION ── */
  function go(id) {
    if (id === S.currentScreen) return;
    var from = root.querySelector('[data-screen="' + S.currentScreen + '"]');
    var to   = root.querySelector('[data-screen="' + id + '"]');
    if (!to) return;
    if (from) {
      from.classList.add('is-leaving');
      from.classList.remove('is-active');
      setTimeout(function () { from.classList.remove('is-leaving'); }, 300);
    }
    setTimeout(function () {
      to.classList.add('is-active');
      window.scrollTo({ top: 0, behavior: 'instant' });
    }, 150);
    S.currentScreen = id;
  }

  /* ── FIREBASE ── */
  var fbAuth, rcVerifier;

  function initFirebase() {
    if (!cfg.firebase || !cfg.firebase.apiKey) return false;
    try {
      var app = firebase.initializeApp(cfg.firebase);
      fbAuth = firebase.auth();
      return true;
    } catch (e) {
      console.warn('Firebase init:', e.message);
      return false;
    }
  }

  /* ── PRE-OTP ORDER CHECK ── */
  function checkOrdersExist(phone) {
    var proxyUrl = cfg.shopify && cfg.shopify.appProxyUrl;
    if (!proxyUrl) return Promise.resolve(true);

    var ordersP = fetch(proxyUrl + '/customer-products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phoneNumber: phone, ordersFirst: 20, lineItemsFirst: 20 })
    })
    .then(function (r) { return r.ok ? r.json() : {}; })
    .then(function (data) {
      var customers = data && data.customers && data.customers.edges;
      if (!customers || customers.length === 0) return false;
      for (var ci = 0; ci < customers.length; ci++) {
        var orders = customers[ci].node.orders && customers[ci].node.orders.edges;
        if (!orders || orders.length === 0) continue;
        for (var i = 0; i < orders.length; i++) {
          var order = orders[i].node;
          if (order.cancelledAt) continue;
          var lineItems = order.lineItems && order.lineItems.edges || [];
          for (var j = 0; j < lineItems.length; j++) {
            var ed = detectEdition(lineItems[j].node);
            if (ed === 'artisan' || ed === 'signed') return true;
          }
        }
      }
      return false;
    })
    .catch(function () { return false; });

    var registryBase = (cfg.shopify && cfg.shopify.transferApiUrl) || proxyUrl;
    var registryP = fetch(registryBase + '/check-ownership', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone: phone })
    })
    .then(function (r) { return r.ok ? r.json() : {}; })
    .then(function (d) { return !!d.hasOwnership; })
    .catch(function () { return false; });

    return Promise.all([ordersP, registryP]).then(function (results) {
      return results[0] || results[1];
    });
  }

  function showOrderError() {
    var el = root.querySelector('#sa-err-modal');
    if (el) el.classList.add('on');
  }
  function hideOrderError() {
    var el = root.querySelector('#sa-err-modal');
    if (el) el.classList.remove('on');
  }

  /* ── OTP SEND ── */
  function handleSend() {
    var inputEl = root.querySelector('#sa-phone-input');
    var raw = (inputEl.value || '').replace(/\D/g, '');
    if (raw.length < 10) {
      inputEl.classList.add('err');
      toast('Enter a valid 10-digit mobile number.', 'err');
      setTimeout(function () { inputEl.classList.remove('err'); }, 700);
      return;
    }
    S.phone = S.countryCode + raw;
    hideOrderError();
    showLoad('Checking your account…');
    setBtn('sa-send-otp', true);

    checkOrdersExist(S.phone)
      .then(function (hasOrders) {
        if (!hasOrders) {
          hideLoad();
          setBtn('sa-send-otp', false);
          showOrderError();
          return;
        }
        var phoneDisplay = root.querySelector('#sa-otp-phone');
        if (phoneDisplay) phoneDisplay.textContent = S.phone;
        sendOTP();
      })
      .catch(function () {
        hideLoad();
        setBtn('sa-send-otp', false);
        toast('Unable to verify. Please try again.', 'err');
      });
  }

  function sendOTP() {
    showLoad('Sending verification code…');
    setBtn('sa-send-otp', true);

    if (!fbAuth) {
      hideLoad();
      setBtn('sa-send-otp', false);
      go('otp');
      startResend();
      toast('Demo mode — enter any 6-digit code', 'info');
      return;
    }

    if (!rcVerifier) {
      rcVerifier = new firebase.auth.RecaptchaVerifier('sa-recaptcha', { size: 'invisible', callback: function(){} });
    }

    fbAuth.signInWithPhoneNumber(S.phone, rcVerifier)
      .then(function (res) {
        S.confirmResult = res;
        hideLoad();
        setBtn('sa-send-otp', false);
        go('otp');
        startResend();
        toast('Code sent!', 'ok');
      })
      .catch(function (err) {
        hideLoad();
        setBtn('sa-send-otp', false);
        toast(fbErr(err.code), 'err');
        if (rcVerifier) { rcVerifier.clear(); rcVerifier = null; }
      });
  }

  /* ── OTP BOXES ── */
  function initBoxes() {
    var boxes = Array.from(root.querySelectorAll('.sa-otp-box'));
    boxes.forEach(function (box, i) {
      box.addEventListener('input', function () {
        var v = this.value.replace(/\D/g, '');
        this.value = v.slice(-1);
        if (v && i < boxes.length - 1) boxes[i + 1].focus();
      });
      box.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace' && !this.value && i > 0) { boxes[i - 1].focus(); }
        if (e.key === 'ArrowLeft'  && i > 0)               { boxes[i - 1].focus(); }
        if (e.key === 'ArrowRight' && i < boxes.length - 1){ boxes[i + 1].focus(); }
      });
      box.addEventListener('paste', function (e) {
        e.preventDefault();
        var txt = (e.clipboardData || window.clipboardData).getData('text');
        var digits = txt.replace(/\D/g, '').slice(0, 6);
        digits.split('').forEach(function (d, j) { if (boxes[j]) boxes[j].value = d; });
        var last = Math.min(digits.length, boxes.length - 1);
        if (boxes[last]) boxes[last].focus();
      });
      box.addEventListener('focus', function () { this.select(); });
    });
  }

  function getOTP() {
    return Array.from(root.querySelectorAll('.sa-otp-box')).map(function (b) { return b.value; }).join('');
  }

  /* ── OTP VERIFY ── */
  function handleVerify() {
    var code = getOTP();
    if (code.length !== 6) {
      root.querySelectorAll('.sa-otp-box').forEach(function (b) { b.classList.add('err'); setTimeout(function(){b.classList.remove('err');},600); });
      toast('Enter all 6 digits.', 'err');
      return;
    }

    showLoad('Verifying code…');
    setBtn('sa-verify-otp', true);

    if (!S.confirmResult) {
      // Demo mode
      hideLoad();
      setBtn('sa-verify-otp', false);
      S.customer = { name: 'Raghav Kumar', phone: S.phone };
      var dOrders = demoOrders();
      S.allOrders = dOrders;
      S.orders    = dOrders;
      S.availableEditions = detectAvailableEditions(dOrders);
      if (S.availableEditions.length === 1) {
        S.edition = S.availableEditions[0];
        renderProducts();
        go('products');
      } else {
        updateEditionCards(S.availableEditions);
        go('edition');
      }
      return;
    }

    S.confirmResult.confirm(code)
      .then(function (result) {
        S.fbUser = result.user;
        showLoad('Loading your collection…');
        return fetchOrders().then(filterByOwnership);
      })
      .then(function (orders) {
        S.allOrders = orders;
        S.orders = orders;
        hideLoad();
        setBtn('sa-verify-otp', false);
        var editions = detectAvailableEditions(orders);
        S.availableEditions = editions;
        if (editions.length === 0) {
          showOrderError();
          go('phone');
          return;
        }
        if (editions.length === 1) {
          S.edition = editions[0];
          renderProducts();
          go('products');
        } else {
          updateEditionCards(editions);
          go('edition');
        }
      })
      .catch(function (err) {
        hideLoad();
        setBtn('sa-verify-otp', false);
        root.querySelectorAll('.sa-otp-box').forEach(function (b) { b.value = ''; b.classList.add('err'); setTimeout(function(){b.classList.remove('err');},600); });
        var first = root.querySelector('.sa-otp-box');
        if (first) first.focus();
        toast(fbErr(err.code || err.message), 'err');
      });
  }

  /* ── SHOPIFY: GET CUSTOMER TOKEN (DEPRECATED) ── */
  function getCustomerToken(phone, idToken) {
    return Promise.resolve({ customerAccessToken: 'bypass' });
  }

  /* ── OWNERSHIP REGISTRY INTEGRATION ──
     After OTP, filter out certs transferred away from this user.
     Uses transfer-api. Fails silently if URL not configured.
  ── */
  function filterByOwnership(orders) {
    var apiUrl = (cfg.shopify && cfg.shopify.transferApiUrl)
              || (cfg.shopify && cfg.shopify.appProxyUrl);
    if (!apiUrl || !S.fbUser) return Promise.resolve(orders);

    return S.fbUser.getIdToken(false)
      .then(function (tok) {
        return fetch(apiUrl + '/transfer/lookup', {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + tok, 'Content-Type': 'application/json' }
        });
      })
      .then(function (r) { return r.ok ? r.json() : { certificates: [] }; })
      .then(function (data) {
        var ownershipRecords = data.certificates || [];
        var normalPhone = (S.phone || '').replace(/\D/g, '').slice(-10);

        // Pre-assign editions to line items so same-product multi-edition orders work correctly
        assignNoteEditions(orders);

        // Build set of certIds already covered by Shopify orders
        var orderCertIds = new Set();
        orders.forEach(function (order) {
          var edges = order.lineItems && order.lineItems.edges || [];
          edges.forEach(function (e) {
            var li = e.node;
            var edType = detectEdition(li);
            if (!edType) return;
            var edNum = extractEditionNumber(order, li);
            if (!edNum) return;
            var ptitle = (li.title || (li.variant && li.variant.product && li.variant.product.title) || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
            orderCertIds.add(ptitle + '--' + edNum.replace('#', ''));
          });
        });

        // Cert IDs transferred away from this user — returned directly by backend
        var transferredAway = new Set(data.transferredCertIds || []);

        // Filter at LINE ITEM level — remove individual transferred items, not whole orders
        var filtered = orders.map(function (order) {
          var edges = order.lineItems && order.lineItems.edges || [];
          var keptEdges = edges.filter(function (e) {
            var li = e.node;
            var edType = detectEdition(li);
            if (!edType) return true; // non-eligible items always kept
            var edNum = extractEditionNumber(order, li);
            if (!edNum) return true;
            var slug = (li.title || (li.variant && li.variant.product && li.variant.product.title) || '')
              .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
            return !transferredAway.has(slug + '--' + edNum.replace('#', ''));
          });
          return Object.assign({}, order, { lineItems: { edges: keptEdges } });
        }).filter(function (order) {
          // Drop orders that have no eligible items left
          var edges = order.lineItems && order.lineItems.edges || [];
          return edges.some(function (e) { return !!detectEdition(e.node); });
        });

        // Add synthetic orders for registry records not already in Shopify orders
        ownershipRecords.forEach(function (rec) {
          if (!rec.edition_type || !rec.product_title) return;
          var rp = (rec.current_owner_phone || '').replace(/\D/g, '').slice(-10);
          if (rp !== normalPhone) return; // not current owner
          if (rec.transfer_status === 'rejected') return;
          if (orderCertIds.has(rec.certificate_id)) return; // already shown via Shopify order

          // Use transfer date as the display date
          var transferDate = rec.updated_at || rec.created_at || null;
          // Use enriched image/description from backend
          var imgUrl = rec.product_image_url || null;
          var imgNode = imgUrl ? { url: imgUrl, altText: rec.product_title } : null;

          filtered.push({
            id: 'registry-' + rec.certificate_id,
            name: rec.order_id || '',
            note: rec.edition_number ? 'Edition ' + rec.edition_number : '',
            processedAt: transferDate, createdAt: transferDate, cancelledAt: null,
            lineItems: { edges: [{ node: {
              title: rec.product_title,
              customAttributes: [],
              variant: {
                title: rec.edition_number || '', sku: '',
                image: imgNode, selectedOptions: [],
                product: {
                  title: rec.product_title,
                  description: rec.product_description || '',
                  tags: [rec.edition_type],
                  metafield: { key: 'edition_type', value: rec.edition_type },
                  images: imgNode ? { edges: [{ node: imgNode }] } : { edges: [] },
                  featuredImage: imgNode
                }
              }
            }}] }
          });

          // Fix collector name if Shopify returned no customer (shows as Guest)
          if (S.customer && S.customer.name === 'Guest' && rec.current_owner_name) {
            S.customer.name = rec.current_owner_name;
          }
        });

        return filtered;
      })
      .catch(function () { return orders; }); // Fail silently — never break existing flow
  }

  /* ── BACKEND: FETCH ORDERS ── */
  function fetchOrders() {
    var proxyUrl = cfg.shopify && cfg.shopify.appProxyUrl;
    if (!proxyUrl) return Promise.resolve(demoOrders());

    return fetch(proxyUrl + '/customer-products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phoneNumber: S.phone, ordersFirst: 20, lineItemsFirst: 20 })
    })
    .then(function (r) { if (!r.ok) throw new Error('Backend API ' + r.status); return r.json(); })
    .then(function (data) {
      var customers = data && data.customers && data.customers.edges;
      if (!customers || customers.length === 0) {
        S.customer = { name: 'Guest', phone: S.phone, email: '' };
        return [];
      }
      // Use first customer with a name for display; collect orders from ALL matched customers
      var displayNode = customers[0].node;
      for (var ci = 0; ci < customers.length; ci++) {
        var n = customers[ci].node;
        if ((n.firstName || n.lastName) && !(displayNode.firstName || displayNode.lastName)) {
          displayNode = n;
        }
      }
      S.customer = {
        name: ((displayNode.firstName || '') + ' ' + (displayNode.lastName || '')).trim() || 'Valued Collector',
        phone: S.phone,
        email: displayNode.email || ''
      };
      var seenOrderIds = {};
      var validOrders = [];
      for (var ci = 0; ci < customers.length; ci++) {
        var ordersEdges = customers[ci].node.orders && customers[ci].node.orders.edges || [];
        for (var i = 0; i < ordersEdges.length; i++) {
          var order = ordersEdges[i].node;
          if (order.cancelledAt) continue;
          if (seenOrderIds[order.id]) continue;
          var lineItems = order.lineItems && order.lineItems.edges || [];
          if (lineItems.length === 0) continue;
          var hasEligible = false;
          for (var j = 0; j < lineItems.length; j++) {
            var ed = detectEdition(lineItems[j].node);
            if (ed === 'artisan' || ed === 'signed') { hasEligible = true; break; }
          }
          if (hasEligible) { seenOrderIds[order.id] = true; validOrders.push(order); }
        }
      }
      return validOrders;
    });
  }

  /* ── EDITION TYPE DETECTION ── */
  function detectEdition(li) {
    // 1. Product metafield custom.edition_type (highest priority)
    // Backend (Admin API) returns singular metafield object; fallback handles legacy array format
    var prod0 = li.product || (li.variant && li.variant.product) || {};
    var mfSingle = prod0.metafield;
    var allMfs = mfSingle ? [mfSingle] : (prod0.metafields || []);
    for (var m = 0; m < allMfs.length; m++) {
      var mf = allMfs[m];
      if (mf && mf.key === 'edition_type') {
        var mv = (mf.value || '').toLowerCase().trim();
        if (mv === 'artisan') return 'artisan';
        if (mv === 'signed')  return 'signed';
      }
    }
    // 2. Fallback: variant options, title, SKU, tags, attributes
    var opts   = (li.variant && li.variant.selectedOptions || []).map(function(o){ return o.name.toLowerCase()+' '+o.value.toLowerCase(); }).join(' ');
    var vtitle = ((li.variant && li.variant.title) || '').toLowerCase();
    var ptitle = (li.title || '').toLowerCase();
    var sku    = ((li.variant && li.variant.sku) || '').toLowerCase();
    var tags   = ((li.product && li.product.tags) || (li.variant && li.variant.product && li.variant.product.tags) || []).join(' ').toLowerCase();
    var attrs  = (li.customAttributes || []).map(function(a){ return a.key.toLowerCase()+' '+a.value.toLowerCase(); }).join(' ');
    var all    = [opts, vtitle, ptitle, sku, tags, attrs].join(' ');
    if (/artisan/.test(all)) return 'artisan';
    if (/signed/.test(all))  return 'signed';
    return null;
  }

  /* ── DETECT AVAILABLE EDITIONS FROM ALL ORDERS ── */
  function detectAvailableEditions(orders) {
    var found = {};
    (orders || []).forEach(function (order) {
      var edges = order.lineItems && order.lineItems.edges || [];
      edges.forEach(function (e) {
        var t = detectEdition(e.node);
        if (t) found[t] = true;
      });
    });
    return Object.keys(found);
  }

  /* ── SHOW/HIDE EDITION CARDS BASED ON WHAT CUSTOMER OWNS ── */
  function updateEditionCards(editions) {
    var artisanCard = root.querySelector('[data-edition="artisan"]');
    var signedCard  = root.querySelector('[data-edition="signed"]');
    if (artisanCard) artisanCard.style.display = editions.indexOf('artisan') >= 0 ? '' : 'none';
    if (signedCard)  signedCard.style.display  = editions.indexOf('signed')  >= 0 ? '' : 'none';
  }

  function normalizeEdition(val) {
    if (!val) return null;
    var str = String(val).trim();
    // "64 / 256" or "64/256" → take first number (the individual edition number)
    var slashM = str.match(/^(\d+)\s*[\/]\s*\d+/);
    if (slashM) return '#' + String(parseInt(slashM[1], 10)).padStart(3, '0');
    // "#064" or "064" or "64"
    var numM = str.match(/#?(\d+)/);
    if (numM) return '#' + String(parseInt(numM[1], 10)).padStart(3, '0');
    // No digits found → NOT a valid edition number (e.g. "SYSTEM ASSIGNED (AUTO)")
    return null;
  }

  /**
   * normalizeTitle(title)
   *
   * Normalises a product title for fuzzy comparison.
   * - lowercase
   * - trim + collapse whitespace
   * - strip line breaks
   * - normalise ALL unicode dashes (en-dash, em-dash, minus, etc.) to ASCII hyphen
   * - normalise ALL apostrophe variants (curly, backtick, etc.) to straight '
   * - remove duplicate punctuation
   */
  function normalizeTitle(title) {
    if (!title) return '';
    return String(title)
      .toLowerCase()
      .replace(/[\r\n\t]+/g, ' ')                           // strip line breaks / tabs
      .replace(/[\u2018\u2019\u201A\u201B\u0060\u00B4]/g, "'")  // all apostrophe variants → '
      .replace(/[\u201C\u201D\u201E\u201F]/g, '"')               // all quote variants → "
      .replace(/[\u2010\u2011\u2012\u2013\u2014\u2015\u2212\uFE58\uFE63\uFF0D]/g, '-')  // all dashes → -
      .replace(/\s+/g, ' ')                                  // collapse spaces
      .trim();
  }

  /**
   * parseOrderNote(note)
   *
   * Parses an order note and returns edition number information.
   *
   * Single-product formats accepted:
   *   "Edition #050"  →  { type: 'single', value: '#050' }
   *   "Edition 050"   →  { type: 'single', value: '#050' }
   *   "#050"          →  { type: 'single', value: '#050' }
   *
   * Multi-product format (pipe-delimited, one per line):
   *   "Product A|Edition #010\nProduct B|Edition #045"
   *   → { type: 'multi', map: { <normalizedTitle>: '#010', ... } }
   *
   * Returns null if no recognisable edition data.
   */
  function parseOrderNote(note) {
    if (!note) return null;
    var raw = note.trim();

    // Detect multi-product: at least one line contains a '|' delimiter
    var lines = raw.split(/[\r\n]+/);
    var pipeLines = lines.filter(function (l) { return l.indexOf('|') !== -1; });

    if (pipeLines.length > 0) {
      // Multi-product mode — build a map: normalizedTitle → editionString
      var map = {};
      pipeLines.forEach(function (line) {
        var pipeIdx = line.indexOf('|');
        if (pipeIdx === -1) return;
        var rawTitle   = line.substring(0, pipeIdx);
        var editionRaw = line.substring(pipeIdx + 1).trim();

        var nTitle = normalizeTitle(rawTitle);
        if (!nTitle) return;

        // Extract numeric portion: "Edition #010", "Edition 010", "#010", "010"
        var m = editionRaw.match(/(?:edition)?[\s#]*(\d+)/i);
        if (m) {
          var edVal = normalizeEdition(m[1]);
          if (edVal) {
            if (!map[nTitle]) map[nTitle] = [];
            map[nTitle].push(edVal);
            console.log('[parseOrderNote] Mapped: "' + nTitle + '" → ' + edVal + ' (slot ' + (map[nTitle].length - 1) + ')');
          }
        }
      });
      if (Object.keys(map).length > 0) return { type: 'multi', map: map };
    }

    // Single-product mode
    var sm = raw.match(/edition[\s#:]*(\d+)/i)
           || raw.match(/#(\d+)/i)
           || raw.match(/(\d+)\s*\/\s*\d+/);
    if (sm) {
      var sVal = normalizeEdition(sm[1]);
      if (sVal) return { type: 'single', value: sVal };
    }

    return null;
  }

  // Pre-assign note editions to line items.
  // Two-pass algorithm:
  //   Pass 1 — collect editions already "claimed" by P1/P2 items (variant title / custom attrs).
  //   Pass 2 — subtract claimed editions from the note array, then assign the REMAINING slots
  //            sequentially to P3 (SYSTEM ASSIGNED / no-variant-edition) items.
  // This prevents a SYSTEM ASSIGNED line item from receiving the same edition number that
  // another line item in the same order already carries via its variant title.
  function assignNoteEditions(orders) {
    // Get P2 edition from variant title (mirrors extractEditionNumber P2 logic)
    var p2Ed = function (li) {
      var vt = (li.variant && li.variant.title) || '';
      if (!vt || /default/i.test(vt)) return null;
      var m = vt.match(/(\d+)\s*[\/]\s*\d+/) || vt.match(/#(\d+)/);
      return m ? normalizeEdition(m[1]) : null;
    };
    // Get P1 edition from customAttributes
    var p1Ed = function (li) {
      var attrs = li.customAttributes || [];
      for (var ai = 0; ai < attrs.length; ai++) {
        if (/edition/i.test(attrs[ai].key || '') && attrs[ai].value) {
          return normalizeEdition(attrs[ai].value.replace(/\D/g, '')) || null;
        }
      }
      return null;
    };

    (orders || []).forEach(function (order) {
      var parsed = parseOrderNote(order.note);
      if (!parsed || parsed.type !== 'multi') return;
      var edges = order.lineItems && order.lineItems.edges || [];

      // Find note map key that matches a line item (exact then partial)
      var findNoteKey = function (li) {
        var nLi   = normalizeTitle(li.title);
        var nProd = normalizeTitle((li.product || (li.variant && li.variant.product) || {}).title);
        if (parsed.map[nLi])           return nLi;
        if (nProd && parsed.map[nProd]) return nProd;
        var nkeys = Object.keys(parsed.map);
        for (var ki = 0; ki < nkeys.length; ki++) {
          var nk = nkeys[ki];
          if ((nLi  && (nLi.indexOf(nk)   !== -1 || nk.indexOf(nLi)   !== -1)) ||
              (nProd && (nProd.indexOf(nk) !== -1 || nk.indexOf(nProd) !== -1))) return nk;
        }
        return null;
      };

      // Pass 1 — build a mutable copy of each note array, removing editions claimed by P1/P2
      var remaining = {};
      Object.keys(parsed.map).forEach(function (k) {
        remaining[k] = parsed.map[k].slice();
      });
      edges.forEach(function (e) {
        var li = e.node;
        var ed = p1Ed(li) || p2Ed(li);
        if (!ed) return;
        var key = findNoteKey(li);
        if (!key) return;
        var arr = remaining[key];
        var idx = arr.indexOf(ed);
        if (idx !== -1) arr.splice(idx, 1);
      });

      // Pass 2 — assign remaining slots to P3 items in order
      edges.forEach(function (e) {
        var li = e.node;
        if (li._noteEdition !== undefined) return;
        if (p1Ed(li) || p2Ed(li)) return;
        var key = findNoteKey(li);
        if (!key || !remaining[key] || remaining[key].length === 0) {
          li._noteEdition = null;
          return;
        }
        li._noteEdition = remaining[key].shift();
        console.log('[assignNoteEditions] ' + (li.title || '') + ' → ' + li._noteEdition);
      });
    });
  }

  /**
   * extractEditionNumber(order, lineItem)
   *
   * Returns the edition number string (e.g. "#010") for a specific line item, or null.
   *
   * Priority:
   *   1. Line Item Property "Edition Number" (customAttributes)
   *   2. Product Variant Title (numeric pattern only)
   *   3. Order note — multi-product: matched by product title; single: used as-is
   *   4. SKU (numeric pattern)
   *
   * Every returned value is validated to contain digits. Non-numeric values
   * like "SYSTEM ASSIGNED (AUTO)" are rejected.
   */
  function extractEditionNumber(order, li) {
    var result;

    // 1. Line item custom attributes — exact "Edition Number" key first, then loose match
    var liAttrs = li.customAttributes || [];
    for (var a = 0; a < liAttrs.length; a++) {
      if (/^edition\s*number$/i.test(liAttrs[a].key.trim())) {
        result = normalizeEdition(liAttrs[a].value);
        if (result) {
          console.log('[extractEditionNumber] P1-exact attr: "' + liAttrs[a].value + '" → ' + result);
          return result;
        }
      }
    }
    for (var b = 0; b < liAttrs.length; b++) {
      if (/edition|number|serial|no\b/i.test(liAttrs[b].key)) {
        result = normalizeEdition(liAttrs[b].value);
        if (result) {
          console.log('[extractEditionNumber] P1-loose attr: "' + liAttrs[b].value + '" → ' + result);
          return result;
        }
      }
    }

    // 2. Variant title (numeric pattern only — e.g. "64 / 256" or "#064")
    //    Variant selectedOptions and raw title are checked but ONLY if they contain digits.
    var vtitle = (li.variant && li.variant.title) || '';
    if (vtitle && !/default/i.test(vtitle)) {
      var vtM = vtitle.match(/(\d+)\s*[\/]\s*\d+/) || vtitle.match(/#(\d+)/);
      if (vtM) {
        result = normalizeEdition(vtM[1]);
        if (result) {
          console.log('[extractEditionNumber] P2 variant title: "' + vtitle + '" → ' + result);
          return result;
        }
      }
    }

    // 3a. Pre-assigned by assignNoteEditions — correct indexed edition for same-product multi-edition orders
    if (li._noteEdition !== undefined) {
      if (li._noteEdition) console.log('[extractEditionNumber] P3a cached: ' + li._noteEdition);
      return li._noteEdition || null;
    }

    // 3b. Order note (parsed) — fallback for items not pre-assigned
    var parsed = parseOrderNote(order.note);
    if (parsed) {
      if (parsed.type === 'single') {
        console.log('[extractEditionNumber] P3 single note → ' + parsed.value);
        return parsed.value;
      }
      if (parsed.type === 'multi') {
        // Normalise the line item title using normalizeTitle for robust matching
        var prod   = li.product || (li.variant && li.variant.product) || {};
        var nLi    = normalizeTitle(li.title);
        var nProd  = normalizeTitle(prod.title);

        console.log('[extractEditionNumber] P3 multi-note matching:');
        console.log('  LINE ITEM TITLE (raw):  "' + (li.title || '') + '"');
        console.log('  LINE ITEM TITLE (norm): "' + nLi + '"');
        console.log('  PRODUCT TITLE (raw):    "' + (prod.title || '') + '"');
        console.log('  PRODUCT TITLE (norm):   "' + nProd + '"');

        var noteKeys = Object.keys(parsed.map);
        for (var k = 0; k < noteKeys.length; k++) {
          console.log('  NOTE KEY [' + k + ']: "' + noteKeys[k] + '" → ' + parsed.map[noteKeys[k]]);
        }

        // Exact match on normalised titles (map values are arrays; take first element as fallback)
        var _pickEd = function (arr) { return Array.isArray(arr) ? arr[0] : arr; };
        if (parsed.map[nLi]) {
          var _ed = _pickEd(parsed.map[nLi]);
          console.log('  MATCH: exact on lineItem title → ' + _ed);
          return _ed;
        }
        if (nProd && parsed.map[nProd]) {
          var _ed2 = _pickEd(parsed.map[nProd]);
          console.log('  MATCH: exact on product title → ' + _ed2);
          return _ed2;
        }

        // Partial / substring match
        for (var j = 0; j < noteKeys.length; j++) {
          var nk = noteKeys[j];
          if (nLi.indexOf(nk) !== -1   || nk.indexOf(nLi) !== -1 ||
              (nProd && (nProd.indexOf(nk) !== -1 || nk.indexOf(nProd) !== -1))) {
            var _ed3 = _pickEd(parsed.map[nk]);
            console.log('  MATCH: partial "' + nk + '" → ' + _ed3);
            return _ed3;
          }
        }

        console.log('  NO MATCH found for this line item in multi-product note.');
        // No match — do NOT fall back to another product's edition
        return null;
      }
    }

    // 4. SKU fallback
    var sku  = (li.variant && li.variant.sku) || '';
    var skuM = sku.match(/(\d+)[-\/](\d+)/);
    if (skuM) {
      result = normalizeEdition(skuM[1]);
      if (result) {
        console.log('[extractEditionNumber] P4 SKU: "' + sku + '" → ' + result);
        return result;
      }
    }

    console.log('[extractEditionNumber] No edition found for: "' + (li.title || '') + '"');
    return null;
  }

  function getSignMonth(li, order) {
    var attrs = [].concat(order.customAttributes || [], li.customAttributes || []);
    for (var i = 0; i < attrs.length; i++) {
      if (/month|sign|date/i.test(attrs[i].key)) return attrs[i].value;
    }
    var m = (order.note || '').match(/(?:signed|month|sign date)[\s:]*([A-Za-z]+(?:\s+\d{4})?)/i);
    if (m) return m[1];
    if (order.processedAt) return new Date(order.processedAt).toLocaleDateString('en-US',{month:'long',year:'numeric'});
    return null;
  }

  function getSerial(li, order) {
    var attrs = [].concat(li.customAttributes || [], order.customAttributes || []);
    for (var i = 0; i < attrs.length; i++) {
      if (/serial|cert|coa/i.test(attrs[i].key)) return attrs[i].value;
    }
    var en = extractEditionNumber(order, li);   // use new helper (forward-ref OK — hoisted at call time)
    return en ? en.replace(/\//g,'-') : (order.name || '').replace('#','');
  }

  function getCollector(order) {
    var attrs = order.customAttributes || [];
    for (var i = 0; i < attrs.length; i++) {
      if (/name|collector|buyer/i.test(attrs[i].key)) return attrs[i].value;
    }
    var m = (order.note || '').match(/(?:name|collector)[\s:]+([A-Za-z\s]+?)(?:\.|,|$)/i);
    if (m) return m[1].trim();
    return S.customer && S.customer.name || null;
  }

  function buildCert(order, li) {
    var prod = li.product || (li.variant && li.variant.product) || {};
    return {
      editionType: detectEdition(li),
      collector:   getCollector(order) || (S.customer && S.customer.name) || 'Valued Collector',
      productName: prod.title || li.title,
      editionNum:  extractEditionNumber(order, li),   // uses new priority-chain helper
      serial:      getSerial(li, order),
      signMonth:   getSignMonth(li, order),
      orderNum:    order.name,
      orderDate:   order.processedAt || order.createdAt,
      desc:        prod.description || '',
      imgUrl:      (li.variant && li.variant.image && li.variant.image.url)
                || (prod.images && prod.images.edges && prod.images.edges[0]
                    && prod.images.edges[0].node && prod.images.edges[0].node.url)
                || null
    };
  }

  /* ── RENDER PRODUCTS ── */
  function renderProducts() {
    var grid    = root.querySelector('#sa-pgrid');
    var nameEl  = root.querySelector('#sa-cust-name');
    var eyeEl   = root.querySelector('#sa-products-eye');
    var subEl   = root.querySelector('#sa-products-sub');
    var countEl = root.querySelector('#sa-item-count');
    var backBtn = root.querySelector('#sa-products-back');
    var backLbl = root.querySelector('#sa-products-back-label');
    if (!grid) return;

    // Dynamic heading
    var edLabel = S.edition === 'artisan' ? 'Artisan Editions' : S.edition === 'signed' ? 'Signed Editions' : 'Your Collection';
    if (nameEl) nameEl.textContent = edLabel;
    if (eyeEl)  eyeEl.textContent  = 'Welcome back' + (S.customer && S.customer.name ? ', ' + S.customer.name : '');
    if (subEl)  subEl.textContent  = 'Your verified collectibles are listed below.';

    // Dynamic back button
    if (backBtn && backLbl) {
      if (S.availableEditions.length > 1) {
        backLbl.textContent = 'Switch Edition';
        backBtn.onclick = function () { go('edition'); };
      } else {
        backLbl.textContent = 'Sign Out';
        backBtn.onclick = function () {
          S.edition = null; S.orders = []; S.allOrders = []; S.availableEditions = [];
          S.customer = null; S.fbUser = null; S.confirmResult = null; S.phone = null;
          hideOrderError();
          var inp = root.querySelector('#sa-phone-input');
          if (inp) inp.value = '';
          go('phone');
        };
      }
    }

    var items = [];
    (S.orders || []).forEach(function (order) {
      var edges = order.lineItems && order.lineItems.edges || [];
      edges.forEach(function (e) {
        var li = e.node;
        var ed = detectEdition(li);
        if (!S.edition || ed === S.edition) items.push({ order: order, li: li, ed: ed });
      });
    });

    if (countEl) countEl.textContent = items.length + (items.length === 1 ? ' Item' : ' Items');

    if (!items.length) {
      grid.innerHTML = '<div class="sa-empty"><h3>No items found</h3><p>No ' + (S.edition || '') + ' edition collectibles found for your account.</p></div>';
      return;
    }

    grid.innerHTML = items.map(function (item, idx) { return cardHTML(item, idx); }).join('');

    grid.querySelectorAll('[data-cert-idx]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = parseInt(this.dataset.certIdx, 10);
        if (items[idx]) openCert(items[idx]);
      });
    });

    grid.querySelectorAll('[data-pdf-idx]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = parseInt(this.dataset.pdfIdx, 10);
        if (items[idx]) { S.activeCert = buildCert(items[idx].order, items[idx].li); makePDF(S.activeCert, this, false); }
      });
    });
  }

  function cardHTML(item, idx) {
    var cert = buildCert(item.order, item.li);
    var isA  = item.ed === 'artisan';
    var tag  = isA ? 'sa-pcard--a' : 'sa-pcard--s';
    var tagLabel = isA ? 'Artisan' : (item.ed === 'signed' ? 'Signed' : 'Collectible');
    var tagCls   = isA ? 'sa-pcard__tag--a' : 'sa-pcard__tag--s';
    var imgHtml  = cert.imgUrl
      ? '<img src="' + xss(cert.imgUrl) + '" alt="' + xss(cert.productName) + '" loading="lazy">'
      : '<div class="sa-pcard__ph"><svg viewBox="0 0 24 24" fill="none" stroke="' + (isA ? '#ccc' : '#555') + '" stroke-width="1.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
    var edPill = cert.editionNum
      ? '<span class="sa-pcard__ed sa-pcard__ed--' + (item.ed || 'a') + '">Edition ' + xss(cert.editionNum) + '</span>'
      : '';
    var dateStr = cert.orderDate
      ? new Date(cert.orderDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
      : '';
    var dateLine = dateStr ? '<p class="sa-pcard__date">' + xss(dateStr) + '</p>' : '';
    return [
      '<div class="sa-pcard ' + tag + '">',
        '<div class="sa-pcard__media">',
          imgHtml,
          '<span class="sa-pcard__tag ' + tagCls + '">' + tagLabel + '</span>',
        '</div>',
        '<div class="sa-pcard__body">',
          '<span class="sa-pcard__kind">' + (isA ? 'Limited Edition Print' : 'Hand-Signed Collectible') + '</span>',
          '<h3 class="sa-pcard__name">' + xss(cert.productName) + '</h3>',
          edPill,
          dateLine,
          '<div class="sa-pcard__actions">',
            '<button class="sa-pcard__btn sa-pcard__btn--cert" data-cert-idx="' + idx + '" type="button">',
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
              'View Certificate',
            '</button>',
            '<button class="sa-pcard__btn sa-pcard__btn--pdf" data-pdf-idx="' + idx + '" type="button">',
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
              'Download PDF',
            '</button>',
          '</div>',
        '</div>',
      '</div>'
    ].join('');
  }

  /* ── OPEN CERTIFICATE ── */
  function openCert(item) {
    var cert = buildCert(item.order, item.li);
    S.activeCert = cert;
    var screenId = cert.editionType === 'signed' ? 'cert-signed' : 'cert-artisan';
    var screen = root.querySelector('[data-screen="' + screenId + '"]');
    if (!screen) return;

    /* Populate fields */
    function fill(sel, val) {
      screen.querySelectorAll(sel).forEach(function(el){ el.textContent = val || '—'; });
    }
    fill('.sa-cert__collector',    cert.collector);
    fill('.sa-cert__product-name', cert.productName);
    fill('.sa-cert__product-name2',cert.productName);
    fill('.sa-cert__edition',      cert.editionNum ? 'Edition ' + cert.editionNum : '—');
    fill('.sa-cert__edition2',     cert.editionNum ? 'Edition ' + cert.editionNum : '—');
    fill('.sa-cert__serial',       cert.serial || '—');
    fill('.sa-cert__order',        cert.orderNum || '—');
    fill('.sa-cert__date',         cert.orderDate ? new Date(cert.orderDate).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) : '—');
    fill('.sa-cert__desc-txt',     cert.desc || '');

    /* COA fields */
    fill('.sa-coa__serial',        cert.serial || '—');
    fill('.sa-coa__month',         cert.signMonth || '—');
    if (cert.productName) {
      screen.querySelectorAll('.sa-coa__body').forEach(function(el){
        el.textContent = 'This certifies that the accompanying item — ' + cert.productName + ' — has been personally autographed and is a numbered limited edition piece.' + (cert.serial ? ' Serial: ' + cert.serial + '.' : '');
      });
    }

    /* Product image */
    var imgEl = screen.querySelector('.sa-cert__pimg img');
    var phEl  = screen.querySelector('.sa-cert__pimg-ph');
    if (imgEl && phEl) {
      if (cert.imgUrl) { imgEl.src = cert.imgUrl; imgEl.removeAttribute('style'); phEl.style.display = 'none'; }
      else             { imgEl.style.display = 'none'; phEl.removeAttribute('style'); }
    }

    /* Wire PDF/View buttons */
    screen.querySelectorAll('[data-cert-pdf]').forEach(function (btn) {
      btn.onclick = function () { makePDF(cert, btn, false); };
    });
    screen.querySelectorAll('[data-cert-view]').forEach(function (btn) {
      btn.onclick = function () { makePDF(cert, btn, true); };
    });

    go(screenId);
  }

  /* ── PDF GENERATION (pure jsPDF — no html2canvas to avoid Shopify theme conflicts) ── */
  function makePDF(cert, btn, viewOnly) {
    var jspdf = window.jspdf;
    if (!jspdf) { toast('PDF library loading, please try again.', 'info'); return; }

    if (btn) btn.disabled = true;
    showLoad('Generating certificate…');

    setTimeout(function () {
      try {
        var pdf  = new jspdf.jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
        var dark = cert.editionType === 'signed';
        var W = 210, H = 297, M = 18;

        // Background
        if (dark) { pdf.setFillColor(16, 16, 16); pdf.rect(0, 0, W, H, 'F'); }

        var cInk  = dark ? [255,255,255] : [8,8,8];
        var cMute = dark ? [140,140,140] : [120,120,120];
        var cGold = [196,154,24];
        var cBox  = dark ? [28,28,28] : [244,242,239];
        var cSep  = dark ? [48,48,48] : [218,216,213];

        function ink()  { pdf.setTextColor.apply(pdf, cInk);  }
        function mute() { pdf.setTextColor.apply(pdf, cMute); }
        function gold() { pdf.setTextColor.apply(pdf, cGold); }

        var y = M + 2;

        // ── Brand
        pdf.setFont('helvetica', 'bold');
        pdf.setFontSize(22);
        ink();
        pdf.text('LEGXI', W/2, y, { align: 'center' }); y += 7;

        pdf.setFontSize(7);
        mute();
        pdf.text('CERTIFICATE OF AUTHENTICITY', W/2, y, { align: 'center' }); y += 5;

        pdf.setDrawColor.apply(pdf, cGold);
        pdf.setLineWidth(0.5);
        pdf.line(W/2 - 18, y, W/2 + 18, y); y += 12;

        // ── "Is Verified"
        pdf.setFontSize(20);
        pdf.setFont('helvetica', 'bold');
        dark ? gold() : ink();
        pdf.text('Is Verified', W/2, y, { align: 'center' }); y += 7;

        pdf.setFont('helvetica', 'normal');
        pdf.setFontSize(9);
        mute();
        pdf.text('This product has been authenticated and verified by LEGXI.', W/2, y, { align: 'center' }); y += 14;

        // ── Info rows
        var rows = [
          ["Collector's Name", cert.collector || '—'],
          ['Product',          cert.productName || '—'],
          cert.editionNum  ? ['Edition Number',        'Edition ' + cert.editionNum] : null,
          cert.serial      ? ['Serial / Certificate',  cert.serial]                  : null,
          cert.orderNum    ? ['Order Number',           cert.orderNum]                : null,
          cert.orderDate   ? ['Purchase Date',          new Date(cert.orderDate).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'})] : null,
          (dark && cert.signMonth) ? ['Month of Signing', cert.signMonth] : null,
        ].filter(Boolean);

        var rowH  = 13;
        var boxH  = 8 + rows.length * rowH + 4;
        pdf.setFillColor.apply(pdf, cBox);
        pdf.roundedRect(M, y, W - M*2, boxH, 2, 2, 'F');

        var ry = y + 9;
        rows.forEach(function (r, i) {
          pdf.setFont('helvetica', 'bold');
          pdf.setFontSize(7);
          mute();
          pdf.text(String(r[0]).toUpperCase(), M + 7, ry);

          pdf.setFont('helvetica', 'bold');
          pdf.setFontSize(10);
          ink();
          var val = String(r[1] || '—');
          var split = pdf.splitTextToSize(val, (W - M*2) - 70);
          pdf.text(split[0] + (split.length > 1 ? '…' : ''), W - M - 7, ry + 3.5, { align: 'right' });

          ry += rowH;
          if (i < rows.length - 1) {
            pdf.setDrawColor.apply(pdf, cSep);
            pdf.setLineWidth(0.2);
            pdf.line(M + 7, ry - 3, W - M - 7, ry - 3);
          }
        });

        y += boxH + 10;

        // ── Description
        if (cert.desc && y < H - 50) {
          pdf.setFont('helvetica', 'bold');
          pdf.setFontSize(7);
          mute();
          pdf.text('ABOUT THIS PIECE', M, y); y += 5;

          pdf.setFont('helvetica', 'normal');
          pdf.setFontSize(9);
          mute();
          var descLines = pdf.splitTextToSize(cert.desc.slice(0, 600), W - M*2);
          var maxL = Math.min(descLines.length, 7);
          pdf.text(descLines.slice(0, maxL), M, y);
          y += maxL * 4.5 + 6;
        }

        // ── Footer
        pdf.setDrawColor.apply(pdf, cSep);
        pdf.setLineWidth(0.3);
        pdf.line(M, H - 14, W - M, H - 14);
        pdf.setFont('helvetica', 'normal');
        pdf.setFontSize(7);
        pdf.setTextColor.apply(pdf, dark ? [70,70,70] : [180,180,180]);
        pdf.text('© ' + new Date().getFullYear() + ' LEGXI. All rights reserved. Non-transferable document.', W/2, H - 8, { align: 'center' });

        // ── Output
        hideLoad();
        if (btn) btn.disabled = false;

        if (viewOnly) {
          var blob = pdf.output('blob');
          var url  = URL.createObjectURL(blob);
          window.open(url, '_blank');
          toast('Certificate opened in new tab.', 'ok');
        } else {
          var fname = 'legxi-cert-' + (cert.orderNum || 'cert').replace(/[^a-z0-9]/gi, '-').toLowerCase() + '.pdf';
          pdf.save(fname);
          toast('Certificate downloaded!', 'ok');
        }
      } catch (err) {
        console.error('[PDF]', err);
        hideLoad();
        if (btn) btn.disabled = false;
        toast('PDF generation failed. Try again.', 'err');
      }
    }, 100);
  }

  /* ── RESEND TIMER ── */
  function startResend() {
    S.resendSecs = 30;
    var row = root.querySelector('#sa-resend-row');
    var cnt = root.querySelector('#sa-resend-count');
    var btn = root.querySelector('#sa-resend-btn');
    if (row) row.style.display = '';
    if (btn) { btn.style.display = 'none'; btn.disabled = true; }
    clearInterval(S.resendTimer);
    S.resendTimer = setInterval(function () {
      S.resendSecs--;
      if (cnt) cnt.textContent = S.resendSecs;
      if (S.resendSecs <= 0) {
        clearInterval(S.resendTimer);
        if (row) row.style.display = 'none';
        if (btn) { btn.style.display = ''; btn.disabled = false; }
      }
    }, 1000);
  }

  /* ── HELPERS ── */
  function xss(str) {
    return String(str).replace(/[&<>"']/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":"&#39;" }[c];
    });
  }

  function setBtn(id, loading) {
    var btn = root.querySelector('#' + id);
    if (!btn) return;
    btn.disabled = loading;
    if (loading) btn.classList.add('loading'); else btn.classList.remove('loading');
  }

  var loadTxt = root.querySelector('#sa-loading-txt');
  function showLoad(msg) {
    if (loadTxt) loadTxt.textContent = msg || 'Please wait…';
    var el = root.querySelector('#sa-loading');
    if (el) el.classList.add('on');
  }
  function hideLoad() {
    var el = root.querySelector('#sa-loading');
    if (el) el.classList.remove('on');
  }

  var toastTimer;
  function toast(msg, type) {
    var el = root.querySelector('#sa-toast');
    if (!el) return;
    el.textContent = msg;
    el.className = 'sa-toast sa-toast--' + (type === 'err' ? 'err' : type === 'info' ? 'info' : 'ok') + ' on';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { el.classList.remove('on'); }, 3500);
  }

  function fbErr(code) {
    var m = {
      'auth/invalid-phone-number':    'Invalid phone number format.',
      'auth/too-many-requests':       'Too many attempts. Try again later.',
      'auth/invalid-verification-code':'Incorrect code. Please try again.',
      'auth/code-expired':            'Code expired. Please resend.',
      'auth/quota-exceeded':          'SMS quota exceeded.',
      'auth/captcha-check-failed':    'Security check failed. Refresh and retry.'
    };
    return m[code] || 'An error occurred. Please try again.';
  }

