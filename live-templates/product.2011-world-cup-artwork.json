        "question_zn6QHg": {
          "type": "question",
          "settings": {
            "question": "How Long will it take to deliver your order?",
            "answer": "<p>Orders are dispatched within <strong>3 to 4 days<\/strong>. Delivery across India is completed within <strong>10 days<\/strong>, while international deliveries are completed within <strong>18 days<\/strong>.<\/p>",
