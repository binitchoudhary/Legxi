    "text_with_media_7xcW3p": {
      "type": "text-with-media",
      "blocks": {
        "subheading_zYp3PE": {
          "type": "subheading",
          "settings": {
            "text": "journey that inspires",
            "position": "top_left"
          }
        },
        "heading_nNjXbd": {
          "type": "heading",
          "settings": {
            "text": "From Humble Beginnings To The World Stage",
            "heading_tag": "h4",
            "position": "top_left",
            "highlight_effect": "default",
            "highlight_accent_color": "",
            "highlight_text_color": ""
          }
        },
        "richtext_hVrePi": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>A story shaped by grit, humility, and quiet resolve.</strong> Arshdeep Singh’s journey from the streets of Mohali to the world stage stands as a testament to what sustained belief and discipline can achieve<br/><br/>This limited Gold Edition, featuring <strong>24 carat gold plated elements and personally hand signed by Arshdeep Singh</strong>, captures the essence of that rise. From a young dreamer honing his craft to a match winner under the brightest lights, the artwork preserves the moments that shaped the journey.<br/><br/>More than a visual piece, this edition stands as a tribute to discipline, patience, and belief. Every detail reflects years of unseen effort, reminding us that progress is built one step at a time, long before recognition arrives.<br/><br/>Placed on your wall, it does more than elevate a space. It anchors a mindset. A reminder that small beginnings, when pursued with intent and consistency, can lead to extraordinary outcomes.<br/><br/>This edition invites you to look beyond the frame. To see your own journey reflected in his. To commit to your path. And to build your own LEGXI.</p>",
            "position": "top_left"
          }
        }
      },
      "block_order": [
        "subheading_zYp3PE",
        "heading_nNjXbd",
        "richtext_hVrePi"
      ],
