# Shopify Admin API
SHOPIFY_STORE=5ci887-xv.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-04

# Transfer fee in INR (no currency symbol)
TRANSFER_FEE_AMOUNT=499.00

# Firebase Admin SDK — paste the entire service account JSON minified to one line.
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"legxi-auth","private_key":"...","client_email":"..."}

# Shopify webhook signing secret (Shopify Admin → Settings → Notifications → Webhooks)
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# Admin panel password — must match what you type into the certificate-admin page
ADMIN_SECRET=change_me_to_a_strong_password

# Comma-separated list of allowed CORS origins
# Include your live store + any Shopify preview domains you use
ALLOWED_ORIGINS=https://legxi.co,https://5ci887-xv.myshopify.com

# PORT is set automatically by Cloud Run (8080). Only set locally if needed.
# PORT=3001
