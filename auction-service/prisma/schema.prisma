generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  PREPARING
  LIVE
  EXTENDED
  ENDING
  ENDED
  SETTLED
  ARCHIVED
}

model Auction {
  id                 String        @id @db.VarChar(26)
  shopifyProductId   String        @unique @map("shopify_product_id") @db.VarChar(255)
  startTime          DateTime      @map("start_time") @db.Timestamptz
  endTime            DateTime      @map("end_time") @db.Timestamptz
  status             AuctionStatus @default(DRAFT)
  startingPricePaise BigInt        @map("starting_price_paise")
  reservePricePaise  BigInt?       @map("reserve_price_paise")
  minIncrementPaise  BigInt        @map("min_increment_paise")
  currentPricePaise  BigInt        @map("current_price_paise")
  winningBidId       String?       @unique @map("winning_bid_id") @db.VarChar(26)
  version            Int           @default(1)
  extensionCount     Int           @default(0) @map("extension_count")

  extensionThresholdSec Int @default(60) @map("extension_threshold_sec")
  extensionDurationSec  Int @default(60) @map("extension_duration_sec")
  maxExtensions         Int @default(50) @map("max_extensions")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  bids       Bid[]       @relation("AuctionBids")
  winningBid Bid?        @relation("AuctionWinningBid", fields: [winningBidId], references: [id])
  payments   Payment[]
  bidIntents BidIntent[]

  @@index([status, endTime(sort: Asc)])
  @@map("auctions")
}

model Bid {
  id          String   @id @db.VarChar(26)
  auctionId   String   @map("auction_id") @db.VarChar(26)
  userId      String   @map("user_id") @db.VarChar(128)
  amountPaise BigInt   @map("amount_paise")
  isProxy     Boolean  @default(false) @map("is_proxy")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  auction    Auction    @relation("AuctionBids", fields: [auctionId], references: [id])
  wonAuction Auction?   @relation("AuctionWinningBid")
  bidIntent  BidIntent?

  @@index([auctionId, amountPaise(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bids")
}

model Payment {
  id                   String  @id @db.VarChar(26)
  auctionId            String  @map("auction_id") @db.VarChar(26)
  userId               String  @map("user_id") @db.VarChar(128)
  amountPaise          BigInt  @map("amount_paise")
  gatewayTransactionId String? @unique @map("gateway_transaction_id") @db.VarChar(255)
  status               String  @default("HOLD") @db.VarChar(32)

  auction Auction @relation(fields: [auctionId], references: [id])

  @@index([gatewayTransactionId])
  @@map("payments")
}

model Settlement {
  id                    String   @id @db.VarChar(26)
  auctionId             String   @unique @map("auction_id") @db.VarChar(26)
  winnerId              String   @map("winner_id") @db.VarChar(128)
  paymentState          String   @map("payment_state") @db.VarChar(32)
  settlementStatus      String   @map("settlement_status") @db.VarChar(32)
  paymentWindowOpenedAt DateTime @map("payment_window_opened_at") @db.Timestamptz
  paymentAttempts       Int      @default(0) @map("payment_attempts")
  provider              String?  @db.VarChar(64)
  providerPaymentId     String?  @map("provider_payment_id") @db.VarChar(255)
  providerEventId       String?  @map("provider_event_id") @db.VarChar(255)
  version               Int      @default(1)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settlements")
}

model AuditLog {
  id         String   @id @db.VarChar(26)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(26)
  actorId    String   @map("actor_id") @db.VarChar(128)
  action     String   @db.VarChar(64)
  oldState   Json?    @map("old_state")
  newState   Json?    @map("new_state")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @db.VarChar(26)
  eventType   String    @map("event_type") @db.VarChar(128)
  payload     Json
  status      String    @default("PENDING") @db.VarChar(32)
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  @@index([status, createdAt(sort: Asc)])
  @@map("outbox_events")
}

model IdempotencyKey {
  key            String   @id @db.VarChar(128)
  requestPayload Json?    @map("request_payload")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("idempotency_keys")
}

model WebhookEvent {
  id                String   @id @default(cuid()) @db.VarChar(30)
  provider          String   @db.VarChar(64)
  providerEventId   String   @map("provider_event_id") @db.VarChar(255)
  providerPaymentId String?  @map("provider_payment_id") @db.VarChar(255)
  auctionId         String?  @map("auction_id") @db.VarChar(26)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz
  processedAt       DateTime @map("processed_at") @db.Timestamptz
  status            String   @db.VarChar(32)
  signatureVerified Boolean  @map("signature_verified")
  processingResult  String   @map("processing_result") @db.VarChar(255)
  correlationId     String   @map("correlation_id") @db.VarChar(255)
  requestId         String   @map("request_id") @db.VarChar(255)
  retryCount        Int      @default(0) @map("retry_count")
  rawPayloadHash    String?  @map("raw_payload_hash") @db.VarChar(255)

  @@unique([provider, providerEventId])
  @@index([auctionId])
  @@map("webhook_events")
}

model User {
  id           String   @id @db.VarChar(128)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  roles        Json     @default("[\"USER\"]")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid()) @db.VarChar(30)
  userId     String    @map("user_id") @db.VarChar(128)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  replacedBy String?   @map("replaced_by") @db.VarChar(30)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model BidIntent {
  intentId    String @id @map("intent_id") @db.VarChar(36)
  auctionId   String @map("auction_id") @db.VarChar(26)
  userId      String @map("user_id") @db.VarChar(128)
  amountPaise BigInt @map("amount_paise")

  bidId String? @unique @map("bid_id") @db.VarChar(26)
  bid   Bid?    @relation(fields: [bidId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  auction Auction @relation(fields: [auctionId], references: [id])

  @@index([createdAt(sort: Asc)])
  @@map("bid_intents")
}
