  <script>
    /* Open cart drawer after every successful add-to-cart.
       We trigger cart:refresh so the drawer fetches fresh section HTML,
       then open it only once cart-drawer:refreshed confirms content is ready. */
    document.addEventListener('cart:change', function (e) {
      if (!e.detail || e.detail.baseEvent !== 'variant:add') return;
      var drawer = document.querySelector('cart-drawer');
      if (!drawer || drawer.open || typeof drawer.show !== 'function') return;
      drawer.addEventListener('cart-drawer:refreshed', function () {
        drawer.show();
      }, { once: true });
      document.dispatchEvent(new CustomEvent('cart:refresh'));
    });
  </script>

  </body>
</html>