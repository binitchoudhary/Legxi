      }
    },
    {
      "@type": "Question",
      "name": "Can I transfer ownership of my LEGXI collectible?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. LEGXI's Ownership Transfer System allows you to register a verified transfer of ownership for any collectible. This maintains an unbroken, auditable chain of custody and preserves the full provenance record — protecting the long-term value of the item for you and any future owner."
      }
