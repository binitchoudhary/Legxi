<script>
(function() {
  /* ── state ── */
  var lgxHmProducts   = null; // [{pid, title, vid, price, img}]
  var lgxHmProductIds = [];

  /* ── lgxHmAdd exposed globally for inline onclick handlers ── */
  window.lgxHmAdd = function(vid, btn) {
  if (btn.disabled) return;
  btn.disabled = true;
  var orig = btn.textContent;
  btn.textContent = '···';
  
  var drawer = document.querySelector('cart-drawer');
  var sectionId = 'cart-drawer';
  if (drawer) {
    var section = drawer.closest('.shopify-section') || drawer.closest('[id^="shopify-section-"]');
    if (section && section.id) {
      sectionId = section.id.replace('shopify-section-', '');
    }
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ items: [{ id: vid, quantity: 1 }], sections: sectionId })
  })
  .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
  .then(function(cart) {
    document.documentElement.dispatchEvent(new CustomEvent('cart:change', {
      bubbles: true, detail: { cart: cart, baseEvent: 'variant:add' }
    }));
    document.dispatchEvent(new CustomEvent('cart:refresh'));
  })
  .catch(function() {
    btn.disabled = false;
    btn.textContent = orig;
  });
};

  /* ── helpers ── */
  function resizeImg(src) {
    return src ? src.replace(/(\.\w{3,4})(\?|$)/, '_160x160$1$2') : '';
  }

  /* ── core: re-render suggestions based ONLY on Heritage Mini items ── */
  function lgxHmRefresh(cartItems) {
    var root = document.getElementById('lgx-hm-suggest-root');
    if (!root || !lgxHmProducts) return;
    var row = document.getElementById('lgx-hm-suggest-row');
    if (!row) return;

    root.setAttribute('data-lgx-ready', '1');

    // Filter to Heritage Mini items only — all other cart products are ignored entirely
    var hmItems    = cartItems.filter(function(item) {
      return lgxHmProductIds.indexOf(item.product_id) !== -1;
    });
    var hmCount    = hmItems.reduce(function(n, item) { return n + item.quantity; }, 0);
    var hmCartPids = hmItems.map(function(item) { return item.product_id; });

    if (hmCount >= 3) {
      root.style.display = 'none';
      return;
    }

    // Suggest HM products not already in cart
    var available = lgxHmProducts
      .filter(function(p) { return hmCartPids.indexOf(p.pid) === -1; })
      .slice(0, 3);

    row.innerHTML = available.map(function(c) {
      return '<div class="lgx-hm-scard">' +
        '<div class="lgx-hm-scard__img">' +
          (c.img ? '<img src="' + c.img + '" alt="" loading="lazy" width="80" height="80">' : '') +
        '</div>' +
        '<p class="lgx-hm-scard__name">' + c.title + '</p>' +
        '<p class="lgx-hm-scard__price">₹' + Math.round(c.price).toLocaleString('en-IN') + '</p>' +
        '<button type="button" class="lgx-hm-scard__add" onclick="lgxHmAdd(' + c.vid + ',this)">Add</button>' +
      '</div>';
    }).join('');

    root.style.display = available.length > 0 ? '' : 'none';
  }

  /* ── detect a freshly-rendered suggest-root (no data-lgx-ready) after AJAX section re-render ── */
  function lgxHmCheckNew() {
    var root = document.getElementById('lgx-hm-suggest-root');
    if (!root || root.getAttribute('data-lgx-ready')) return;
    root.setAttribute('data-lgx-ready', '1');

    function doRefresh() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) { lgxHmRefresh(cart.items || []); })
        .catch(function() {});
    }

    if (!lgxHmProducts) {
      // Products not cached yet (page loaded with 0 HMs) — fetch now
      var coll = root.getAttribute('data-hm-collection') || 'legxi-heritage-minis';
      fetch('/collections/' + coll + '/products.json?limit=10')
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(d) { if (d) parseCollection(d); })
        .then(doRefresh)
        .catch(doRefresh);
    } else {
      doRefresh();
    }
  }

  /* ── listen for cart:change (fired by lgxHmAdd and theme quantity selectors) ── */
  function lgxHmOnCartChange(e) {
    var cart = e.detail && e.detail.cart;
    if (!cart) return;
    if (lgxHmProducts) {
      setTimeout(function() { lgxHmRefresh(cart.items || []); }, 0);
    } else {
      setTimeout(lgxHmCheckNew, 0);
    }
  }
  // Some themes dispatch on document.documentElement, others directly on document.
  // Listen on both; guard the document listener to avoid double-firing for bubbled events.
  document.documentElement.addEventListener('cart:change', lgxHmOnCartChange);
  document.addEventListener('cart:change', function(e) {
    if (e.target === document) lgxHmOnCartChange(e);
  });

  /* ── MutationObserver: catches AJAX section re-renders that don't fire cart:change ── */
  // Observe document.body (not the section element): Shopify AJAX re-renders replace the
  // entire section node, which would detach an observer watching that specific element.
  function setupObserver() {
    new MutationObserver(function() {
      clearTimeout(window._lgxHmObTimer);
      window._lgxHmObTimer = setTimeout(function() {
        lgxHmCheckNew();
        if (typeof lgxRoyalCheckNew === 'function') lgxRoyalCheckNew();
      }, 40);
    }).observe(document.body, { childList: true, subtree: true });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupObserver);
  } else {
    setupObserver();
  }

  /* ── init: fetch collection products, then initial cart ── */
  var initRoot = document.getElementById('lgx-hm-suggest-root');
  if (initRoot) {
    var hmCollection = initRoot.getAttribute('data-hm-collection') || 'legxi-heritage-minis';

    function parseCollection(d) {
      lgxHmProducts = (d.products || []).map(function(p) {
        var v = p.variants && p.variants[0];
        if (!v) return null;
        return { pid: p.id, title: p.title, vid: v.id, price: parseFloat(v.price), img: resizeImg(p.images && p.images[0] && p.images[0].src) };
      }).filter(Boolean);
      lgxHmProductIds = lgxHmProducts.map(function(p) { return p.pid; });
    }

    fetch('/collections/' + hmCollection + '/products.json?limit=10')
      .then(function(r) {
        if (!r.ok) throw new Error('404');
        return r.json().then(parseCollection);
      })
      .catch(function() {
        // Fallback: predictive search + per-product fetch
        return fetch('/search/suggest.json?q=Heritage+Minis&type=product&resources[type]=product&resources[limit]=10')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var hits = ((data.resources || {}).results || {}).products || [];
            return Promise.all(hits.filter(function(p) { return p.handle; }).slice(0, 6).map(function(p) {
              return fetch('/products/' + p.handle + '.json').then(function(r) { return r.json(); }).catch(function() { return null; });
            }));
          })
          .then(function(results) {
            lgxHmProducts = (results || []).filter(Boolean).map(function(d) {
              var prod = d && d.product;
              var v = prod && prod.variants && prod.variants[0];
              if (!v) return null;
              return { pid: prod.id, title: prod.title, vid: v.id, price: parseFloat(v.price), img: resizeImg(prod.images && prod.images[0] && prod.images[0].src) };
            }).filter(Boolean);
            lgxHmProductIds = lgxHmProducts.map(function(p) { return p.pid; });
          })
          .catch(function() {});
      })
      .then(function() { return fetch('/cart.js').then(function(r) { return r.json(); }); })
      .then(function(cart) { lgxHmRefresh(cart.items || []); })
      .catch(function() {});
  }

  /* ── ROYAL10 ── */
  var lgxRoyalProducts   = null;
  var lgxRoyalProductId  = null;
  var lgxRoyalScrollPos  = 0;
  var lgxRoyalRendered   = [];

  window.lgxRoyalAdd = function(vid, btn, event) {
    if (event) { event.preventDefault(); event.stopPropagation(); }
    if (btn.disabled) return;
    btn.disabled = true;
    var orig = btn.innerHTML;
    btn.innerHTML = '<span class="lgx-royal-spinner"></span>';
    
    var drawer = document.querySelector('cart-drawer');
    var sectionId = 'cart-drawer';
    if (drawer) {
      var section = drawer.closest('.shopify-section') || drawer.closest('[id^="shopify-section-"]');
      if (section && section.id) {
        sectionId = section.id.replace('shopify-section-', '');
      }
    }
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: vid, quantity: 1 }], sections: sectionId })
    })
    .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function(cart) {
      document.documentElement.dispatchEvent(new CustomEvent('cart:change', {
        bubbles: true, detail: { cart: cart, baseEvent: 'variant:add' }
      }));
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      
      // Auto-restore button state in case drawer doesn't fully replace this node
      setTimeout(function() {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = orig;
        }
      }, 800);
    })
    .catch(function() {
      btn.disabled = false;
      btn.innerHTML = orig;
    });
  };

  function lgxRoyalRefresh() {
    var root = document.getElementById('lgx-royal-suggest-root');
    if (!root || !lgxRoyalProducts) return;
    var row = document.getElementById('lgx-royal-suggest-row');
    if (!row) return;

    root.setAttribute('data-lgx-ready', '1');

    var cartPids = (root.getAttribute('data-cart-pids') || '').split(',').map(Number);
    var eligibleCount = parseInt(root.getAttribute('data-eligible-count') || '0', 10);

    if (eligibleCount >= 3) {
      root.style.display = 'none';
      return;
    }

    var available = lgxRoyalProducts.filter(function(p) { return cartPids.indexOf(p.pid) === -1; });
    var availableIds = available.map(function(p) { return p.pid; }).join(',');

    // Skip DOM replacement if exact same items are to be rendered to preserve smooth experience and scroll
    var hasCards = !!row.querySelector('.lgx-royal-scard');
    if (lgxRoyalRendered === availableIds && hasCards) {
      root.style.display = available.length > 0 ? '' : 'none';
      return;
    }
    lgxRoyalRendered = availableIds;

    row.innerHTML = available.map(function(c) {
      return '<div class="lgx-royal-scard">' +
        '<div class="lgx-royal-scard__img-wrap">' +
          (c.img ? '<img src="' + c.img + '" alt="" loading="lazy" width="120" height="120">' : '') +
        '</div>' +
        '<p class="lgx-royal-scard__name">' + c.title + '</p>' +
        '<p class="lgx-royal-scard__price">₹' + Math.round(c.price).toLocaleString('en-IN') + '</p>' +
        '<button type="button" class="lgx-royal-scard__add" onclick="lgxRoyalAdd(' + c.vid + ',this,event)">Add</button>' +
      '</div>';
    }).join('');

    root.style.display = available.length > 0 ? '' : 'none';

    // Restore scroll after DOM manipulation
    row.scrollLeft = lgxRoyalScrollPos;

    var prev = root.querySelector('.lgx-royal-carousel-prev');
    var next = root.querySelector('.lgx-royal-carousel-next');
    
    // Attach smooth scroll logic
    if (prev) prev.onclick = function() { row.scrollBy({left: -row.clientWidth, behavior: 'smooth'}); };
    if (next) next.onclick = function() { row.scrollBy({left: row.clientWidth, behavior: 'smooth'}); };

    function updateArrows() {
      if (!prev || !next) return;
      var cw = row.clientWidth;
      var sw = row.scrollWidth;
      
      if (cw === 0) {
        prev.style.display = 'flex';
        next.style.display = 'flex';
        prev.style.opacity = lgxRoyalScrollPos > 5 ? '1' : '0.3';
        prev.style.pointerEvents = lgxRoyalScrollPos > 5 ? 'auto' : 'none';
        next.style.opacity = '1';
        next.style.pointerEvents = 'auto';
        return;
      }
      
      var canScroll = sw > cw;
      if (!canScroll && lgxRoyalRendered.length <= 4) {
        prev.style.display = 'none';
        next.style.display = 'none';
        return;
      }
      
      prev.style.display = 'flex';
      next.style.display = 'flex';
      prev.style.opacity = (row.scrollLeft > 5) ? '1' : '0.3';
      prev.style.pointerEvents = (row.scrollLeft > 5) ? 'auto' : 'none';
      next.style.opacity = (Math.ceil(row.scrollLeft + cw) < sw - 5) ? '1' : '0.3';
      next.style.pointerEvents = (Math.ceil(row.scrollLeft + cw) < sw - 5) ? 'auto' : 'none';
    }
    row.addEventListener('scroll', function() {
      lgxRoyalScrollPos = row.scrollLeft;
      updateArrows();
    });
    setTimeout(updateArrows, 100);
    window.addEventListener('resize', updateArrows);
  }

  function lgxRoyalRenderSkeletons(row) {
    var skels = '';
    for(var i=0; i<4; i++){
      skels += '<div class="lgx-royal-scard">' +
        '<div class="lgx-royal-scard__img-wrap"><div class="lgx-skel"></div></div>' +
        '<p class="lgx-royal-scard__name lgx-skel"></p>' +
        '<p class="lgx-royal-scard__price lgx-skel"></p>' +
        '<button type="button" class="lgx-royal-scard__add lgx-skel" disabled></button>' +
      '</div>';
    }
    row.innerHTML = skels;
  }

  function lgxRoyalCheckNew() {
    var root = document.getElementById('lgx-royal-suggest-root');
    if (!root || root.getAttribute('data-lgx-ready')) return;
    root.setAttribute('data-lgx-ready', '1');

    var pid = root.getAttribute('data-product-id');
    if (!pid) { lgxRoyalProducts = []; lgxRoyalRendered = ''; lgxRoyalRefresh(); return; }

    var row = document.getElementById('lgx-royal-suggest-row');

    if (!lgxRoyalProducts || lgxRoyalProductId != pid) {
      lgxRoyalProductId = pid;
      
      if(row) lgxRoyalRenderSkeletons(row);

      var type = root.getAttribute('data-product-type');
      var vendor = root.getAttribute('data-product-vendor');
      var coll = root.getAttribute('data-product-collection');

      var extractProducts = function(r) {
        if (!r.ok) {
          return null;
        }
        return r.text().then(function(text) {
          try {
            var m = text.match(/\[[\s\S]*\]/);
            if (m) {
              var products = JSON.parse(m[0]);
              return { products: products };
            }
          } catch(e) {
          }
          return null;
        }).catch(function(e) {
          return null;
        });
      };

      var fetchColl = coll ? fetch('/collections/' + coll + '?section_id=lgx-royal-api').then(extractProducts) : Promise.resolve(null);
      var fetchType = type ? fetch('/search?q=' + encodeURIComponent(type) + '&section_id=lgx-royal-api').then(extractProducts) : Promise.resolve(null);
      var fetchVendor = vendor ? fetch('/search?q=' + encodeURIComponent(vendor) + '&section_id=lgx-royal-api').then(extractProducts) : Promise.resolve(null);
      var fetchRecs = fetch('/recommendations/products?section_id=lgx-royal-api&product_id=' + pid + '&limit=10&intent=related').then(extractProducts);
      var fetchComp = fetch('/recommendations/products?section_id=lgx-royal-api&product_id=' + pid + '&limit=10&intent=complementary').then(extractProducts);
      var fetchAll = fetch('/collections/all?section_id=lgx-royal-api').then(extractProducts); // Huge fallback to guarantee carousel scrolling

      Promise.all([fetchColl, fetchType, fetchVendor, fetchRecs, fetchComp, fetchAll]).then(function(results) {
        var allProds = [];
        var seen = {};
        
        function addList(d) {
          if (!d) return;
          var arr = d.products || (((d.resources||{}).results||{}).products);
          if (arr) {
            arr.forEach(function(p) {
              if (p.id == pid || seen[p.id]) return;
              var v = p.variants && p.variants[0];
              if (!v) return;
              seen[p.id] = true;
              var imgSrc = (p.images && p.images[0] && (p.images[0].src || p.images[0])) || p.image || (typeof p.featured_image === 'string' ? p.featured_image : (p.featured_image && p.featured_image.url)) || (p.featured_media && p.featured_media.preview_image && p.featured_media.preview_image.src) || 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png';
              allProds.push({ pid: p.id, title: p.title, vid: v.id, price: parseFloat(v.price), img: resizeImg(imgSrc) });
            });
          }
        }
        
        for (var i = 0; i < 6; i++) {
          if (allProds.length >= 10) break;
          addList(results[i]);
        }
        
        lgxRoyalProducts = allProds;
        lgxRoyalRendered = '';
        lgxRoyalScrollPos = 0; // reset scroll for new products
        lgxRoyalRefresh();
      }).catch(function(){
        lgxRoyalProducts = [];
        lgxRoyalRendered = '';
        lgxRoyalRefresh();
      });
    } else {
      // Re-use cached products, this prevents scroll flicker on quantity change
      if (row) row.scrollLeft = lgxRoyalScrollPos;
      lgxRoyalRefresh();
    }
  }

  function lgxRoyalOnCartChange(e) {
    var cart = e.detail && e.detail.cart;
    if (!cart) return;
    setTimeout(lgxRoyalCheckNew, 0);
  }

  document.documentElement.addEventListener('cart:change', lgxRoyalOnCartChange);
  document.addEventListener('cart:change', function(e) {
    if (e.target === document) lgxRoyalOnCartChange(e);
  });
  
  setTimeout(lgxRoyalCheckNew, 0);
})();
</script>

