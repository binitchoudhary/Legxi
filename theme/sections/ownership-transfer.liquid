{%- comment -%}
  LEGXI — Certificate Ownership Transfer Portal
  Matching design system as Certificate Authentication Portal.
  Root: #ot-root  |  CSS vars scoped to #ot-root  |  No conflicts with sa-root.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,400&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,400&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"></noscript>

<style>
/* ── SHOPIFY SECTION ISOLATION ── */
.shopify-section:has(#ot-root),
.shopify-section > .section-{{ section.id }}:has(#ot-root) {
  max-width:none !important; padding:0 !important; margin:0 !important; width:100% !important; overflow:hidden !important;
}
body:has(#ot-root) .shopify-section:not(:has(#ot-root)) { display:none !important; }
html:has(#ot-root), body:has(#ot-root) { overflow-x:hidden !important; margin:0 !important; padding:0 !important; background:#0d0d0d !important; }

/* ── BASE RESET ── */
#ot-root *,#ot-root *::before,#ot-root *::after { box-sizing:border-box; margin:0; padding:0; }
#ot-root h1,#ot-root h2,#ot-root h3,#ot-root h4,#ot-root h5 {
  font-style:normal; text-decoration:none;
  --heading-font-family:inherit; --heading-text-transform:none; --heading-letter-spacing:0; --heading-line-height:inherit;
}
#ot-root p,#ot-root span,#ot-root label { --text-font-family:inherit; --text-transform:none; --text-letter-spacing:0; }
#ot-root span { display:inline; }
#ot-root strong,#ot-root b { font-weight:bold; }
#ot-root button {
  -webkit-appearance:none !important; appearance:none !important;
  background:none; border:none; padding:0; margin:0; cursor:pointer;
  border-radius:0; display:inline; width:auto; text-decoration:none; box-shadow:none;
  min-height:unset; max-height:unset; --button-font:inherit; --button-text-transform:none;
}
#ot-root input,#ot-root textarea,#ot-root select {
  -webkit-appearance:none !important; appearance:none !important;
  background:none; border:none; outline:none; padding:0; margin:0;
  border-radius:0; box-shadow:none; width:auto;
  font-family:inherit;
}
#ot-root a { text-decoration:none; color:inherit; cursor:pointer; }
#ot-root img { max-width:100%; height:auto; border:none; }

/* ── DESIGN TOKENS ── */
#ot-root {
  isolation:isolate; position:relative; overflow:hidden;
  font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif !important;
  font-size:16px !important; font-weight:400 !important; line-height:1.5 !important;
  color:#080808 !important; -webkit-font-smoothing:antialiased; width:100%;
  --font:   'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  --script: 'Great Vibes',cursive;
  --serif:  'Playfair Display',Georgia,serif;
  --ink:    #080808; --bone:#F4F2EF; --white:#FFFFFF; --ash:#E8E6E3;
  --smoke:  #C8C8C8; --slate:#828282; --fog:#B4B4B4; --coal:#060606;
  --onyx:   #101010; --graphite:#181818;
  --gold:   #C49A18; --gold-lt:#D4B030; --gold-dk:#8A6A08; --gold-dim:rgba(196,154,24,0.12);
  --red:    #DC2626; --green:#16a34a;
  --e2: 0 4px 12px rgba(0,0,0,.07),0 2px 4px rgba(0,0,0,.05);
  --e4: 0 20px 60px rgba(0,0,0,.14),0 8px 20px rgba(0,0,0,.08);
  --e5: 0 40px 100px rgba(0,0,0,.20),0 16px 40px rgba(0,0,0,.10);
  --eg: 0 8px 40px rgba(196,154,24,.28),0 2px 8px rgba(196,154,24,.18);
  --swift:  cubic-bezier(0.22,1,0.36,1);
  --smooth: cubic-bezier(0.4,0,0.2,1);
}

@keyframes ot-fadeUp  { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
@keyframes ot-fadeOut { from{opacity:1;transform:translateY(0)} to{opacity:0;transform:translateY(-14px)} }
@keyframes ot-shake   { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-8px)} 60%{transform:translateX(8px)} }
@keyframes ot-spin    { to{transform:rotate(360deg)} }
@keyframes ot-pulse   { 0%,100%{opacity:1} 50%{opacity:.4} }

/* ── SCREEN SYSTEM ── */
#ot-root .ot-screen { display:none; width:100%; position:relative; overflow-x:hidden; }
#ot-root .ot-screen.is-active  { display:block; animation:ot-fadeUp .5s var(--swift) both; }
#ot-root .ot-screen.is-leaving { display:block; animation:ot-fadeOut .25s var(--smooth) both; }

/* ── SHARED LAYOUT ── */
#ot-root .ot-bg-dark { background:#000; min-height:100vh; min-height:100dvh; display:flex; align-items:center; justify-content:center; padding:32px 20px; position:relative; overflow-x:hidden; }
#ot-root .ot-bg-light { background:var(--bone); min-height:100vh; min-height:100dvh; padding:40px 20px; }
#ot-root .ot-inner { width:100%; max-width:480px; position:relative; z-index:1; }
#ot-root .ot-grid-inner { width:100%; max-width:900px; margin:0 auto; position:relative; z-index:1; }

/* ── BRAND ── */
#ot-root .ot-brand { text-align:center; margin-bottom:28px; }
#ot-root .ot-brand__name { display:block; font-size:clamp(22px,4vw,32px); font-weight:900; letter-spacing:clamp(8px,2vw,16px); text-transform:uppercase; color:#fff; animation:ot-fadeUp .7s var(--swift) .05s both; }
#ot-root .ot-brand__tag  { display:block; font-size:10px; font-weight:600; letter-spacing:4px; text-transform:uppercase; color:rgba(255,255,255,.5); margin-top:8px; animation:ot-fadeUp .7s var(--swift) .15s both; }

/* ── CARD ── */
#ot-root .ot-card { background:var(--white); border-radius:22px; padding:clamp(28px,4vh,48px) clamp(24px,4vw,48px) clamp(24px,3.5vh,40px); box-shadow:var(--e4); position:relative; overflow:hidden; animation:ot-fadeUp .7s var(--swift) .22s both; }
#ot-root .ot-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,transparent,var(--gold) 30%,var(--gold-lt) 50%,var(--gold) 70%,transparent); }
#ot-root .ot-card__icon { width:clamp(48px,6vh,64px); height:clamp(48px,6vh,64px); background:var(--bone); border:1.5px solid var(--ash); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto clamp(14px,2vh,22px); }
#ot-root .ot-card__icon svg { width:clamp(20px,2.8vh,26px); height:clamp(20px,2.8vh,26px); color:var(--ink); }
#ot-root .ot-card__h { font-size:clamp(16px,2.2vh,22px); font-weight:700; letter-spacing:2.5px; text-transform:uppercase; color:var(--ink); text-align:center; margin-bottom:clamp(6px,1vh,10px); }
#ot-root .ot-card__sub { font-size:clamp(13px,1.7vh,14.5px); color:var(--slate); text-align:center; line-height:1.7; margin-bottom:clamp(10px,1.8vh,20px); }

/* ── PROGRESS STEPS ── */
#ot-root .ot-steps { display:flex; align-items:center; justify-content:center; gap:0; margin-bottom:28px; }
#ot-root .ot-step { display:flex; flex-direction:column; align-items:center; gap:5px; }
#ot-root .ot-step__dot { width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; border:2px solid var(--ash); background:var(--white); color:var(--smoke); transition:all .3s; }
#ot-root .ot-step__dot.active { border-color:var(--gold); background:var(--gold); color:#fff; }
#ot-root .ot-step__dot.done  { border-color:var(--green); background:var(--green); color:#fff; }
#ot-root .ot-step__lbl { font-size:9px; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:var(--fog); white-space:nowrap; }
#ot-root .ot-step__line { width:40px; height:2px; background:var(--ash); flex-shrink:0; align-self:flex-start; margin-top:13px; }
@media(max-width:400px) { #ot-root .ot-step__lbl { display:none; } #ot-root .ot-step__line { width:24px; } }

/* ── BADGE ── */
#ot-root .ot-badge { display:flex; align-items:center; justify-content:center; gap:6px; background:var(--gold-dim); border:1px solid rgba(196,154,24,.25); border-radius:20px; padding:6px 16px; font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--gold); margin:0 auto clamp(14px,2vh,24px); width:fit-content; }

/* ── FIELDS ── */
#ot-root .ot-field__lbl { display:block; font-size:10px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--fog); margin-bottom:10px; }
#ot-root .ot-row { display:flex; gap:10px; margin-bottom:10px; }
#ot-root .ot-cc { flex:0 0 90px; height:52px; display:flex; align-items:center; justify-content:center; background:var(--bone); border:1.5px solid var(--ash); border-radius:13px; font-size:14px; font-weight:700; color:var(--ink); cursor:pointer; font-family:inherit; transition:border-color .2s; }
#ot-root .ot-cc:hover { border-color:var(--ink); }
#ot-root .ot-input { flex:1; min-width:0; height:52px; padding:0 14px; font-family:var(--font); font-size:18px; font-weight:600; letter-spacing:2px; color:var(--ink); background:var(--bone); border:1.5px solid var(--ash); border-radius:13px; outline:none; -moz-appearance:textfield; transition:border-color .2s,box-shadow .2s; }
#ot-root .ot-input:focus { border-color:var(--ink); box-shadow:0 0 0 3px rgba(0,0,0,.06); }
#ot-root .ot-input.err { border-color:var(--red); animation:ot-shake .4s var(--smooth); }
#ot-root .ot-input--full { width:100%; height:52px; padding:0 16px; font-family:var(--font); font-size:14px; font-weight:500; color:var(--ink); background:var(--bone); border:1.5px solid var(--ash); border-radius:13px; outline:none; transition:border-color .2s,box-shadow .2s; display:block; margin-bottom:14px; }
#ot-root .ot-input--full:focus { border-color:var(--ink); box-shadow:0 0 0 3px rgba(0,0,0,.06); }
#ot-root .ot-input--full.err { border-color:var(--red); }
#ot-root textarea.ot-input--full { height:88px; padding:14px 16px; resize:none; line-height:1.5; }
#ot-root input::-webkit-outer-spin-button,#ot-root input::-webkit-inner-spin-button { -webkit-appearance:none; }

/* ── OTP BOXES ── */
#ot-root .ot-otp-row { display:flex; gap:10px; justify-content:center; margin-bottom:18px; }
#ot-root .ot-otp-box { width:48px; height:58px; text-align:center; font-size:24px; font-weight:700; color:var(--ink); background:var(--bone); border:1.5px solid var(--ash); border-radius:13px; outline:none; transition:border-color .2s,box-shadow .2s; font-family:var(--font); }
#ot-root .ot-otp-box:focus { border-color:var(--ink); box-shadow:0 0 0 3px rgba(0,0,0,.07); }
#ot-root .ot-otp-box.err  { border-color:var(--red); animation:ot-shake .4s var(--smooth); }
@media(max-width:380px) { #ot-root .ot-otp-box { width:40px; height:52px; font-size:20px; } #ot-root .ot-otp-row { gap:7px; } }

/* ── BUTTON ── */
#ot-root .ot-btn { width:100%; height:52px; background:var(--ink); color:#fff; border-radius:13px; font-family:var(--font); font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; cursor:pointer; transition:background .2s,opacity .2s; display:flex; align-items:center; justify-content:center; gap:8px; }
#ot-root .ot-btn:hover { background:#1a1a1a; }
#ot-root .ot-btn:disabled { opacity:.5; cursor:not-allowed; }
#ot-root .ot-btn--gold { background:var(--gold); }
#ot-root .ot-btn--gold:hover { background:var(--gold-lt); }
#ot-root .ot-btn--outline { background:transparent; border:1.5px solid var(--ash); color:var(--slate); }
#ot-root .ot-btn--outline:hover { border-color:var(--ink); color:var(--ink); }

/* ── RESEND ── */
#ot-root .ot-resend { font-size:12px; color:var(--slate); text-align:center; margin-top:16px; }
#ot-root .ot-resend-btn { font-weight:700; color:var(--ink); cursor:pointer; text-decoration:underline; }
#ot-root .ot-resend-btn:disabled { color:var(--fog); text-decoration:none; cursor:default; }

/* ── CERT CARDS GRID ── */
#ot-root .ot-page-hd { text-align:center; margin-bottom:32px; }
#ot-root .ot-page-hd__eyebrow { font-size:10px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); display:block; margin-bottom:12px; }
#ot-root .ot-page-hd__title { font-size:clamp(22px,3vw,32px); font-weight:800; letter-spacing:-0.5px; color:var(--ink); }
#ot-root .ot-page-hd__sub { font-size:13px; color:var(--slate); margin-top:8px; line-height:1.6; }

#ot-root .ot-certs-grid { display:grid; grid-template-columns:1fr; gap:16px; margin-bottom:32px; }
@media(min-width:600px) { #ot-root .ot-certs-grid { grid-template-columns:1fr 1fr; } }
@media(min-width:860px) { #ot-root .ot-certs-grid { grid-template-columns:1fr 1fr 1fr; } }

#ot-root .ot-cert { background:var(--white); border-radius:18px; border:2px solid var(--ash); padding:24px; cursor:pointer; transition:border-color .25s var(--swift),transform .25s var(--swift),box-shadow .25s; position:relative; }
#ot-root .ot-cert:hover { border-color:var(--gold); transform:translateY(-4px); box-shadow:var(--eg); }
#ot-root .ot-cert.is-selected { border-color:var(--gold); background:#FFFCF2; box-shadow:var(--eg); }
#ot-root .ot-cert::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; border-radius:18px 18px 0 0; opacity:0; transition:opacity .25s; background:linear-gradient(90deg,var(--gold-dk),var(--gold-lt)); }
#ot-root .ot-cert:hover::before, #ot-root .ot-cert.is-selected::before { opacity:1; }
#ot-root .ot-cert__type { font-size:9px; font-weight:700; letter-spacing:2.5px; text-transform:uppercase; padding:4px 10px; border-radius:10px; display:inline-block; margin-bottom:14px; }
#ot-root .ot-cert__type--artisan { background:#FEF9EC; color:#92400E; }
#ot-root .ot-cert__type--signed  { background:#F0FDF4; color:#166534; }
#ot-root .ot-cert__edition { font-family:var(--script); font-size:clamp(40px,6vw,56px); line-height:.85; color:var(--ink); margin-bottom:4px; }
#ot-root .ot-cert__title { font-size:13px; font-weight:700; color:var(--ink); margin-bottom:4px; line-height:1.4; }
#ot-root .ot-cert__order { font-size:11px; color:var(--slate); margin-bottom:14px; }
#ot-root .ot-cert__owner-row { display:flex; align-items:flex-start; gap:8px; padding-top:14px; border-top:1px solid var(--ash); }
#ot-root .ot-cert__owner-icon { width:32px; height:32px; background:var(--bone); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px; }
#ot-root .ot-cert__owner-icon svg { width:14px; height:14px; color:var(--slate); }
#ot-root .ot-cert__owner-lbl { font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--fog); }
#ot-root .ot-cert__owner-name { font-size:13px; font-weight:700; color:var(--ink); }
#ot-root .ot-cert__transfers { margin-top:10px; font-size:10px; color:var(--slate); }
#ot-root .ot-cert__transfers strong { color:var(--gold); }
#ot-root .ot-cert__select-check { position:absolute; top:20px; right:20px; width:24px; height:24px; border-radius:50%; border:2px solid var(--ash); background:var(--white); display:flex; align-items:center; justify-content:center; transition:all .2s; }
#ot-root .ot-cert.is-selected .ot-cert__select-check { background:var(--gold); border-color:var(--gold); }
#ot-root .ot-cert__select-check svg { width:12px; height:12px; color:#fff; opacity:0; transition:opacity .2s; }
#ot-root .ot-cert.is-selected .ot-cert__select-check svg { opacity:1; }

#ot-root .ot-no-certs { text-align:center; padding:60px 20px; }
#ot-root .ot-no-certs__icon { font-size:48px; margin-bottom:16px; }
#ot-root .ot-no-certs__h { font-size:18px; font-weight:700; color:var(--ink); margin-bottom:8px; }
#ot-root .ot-no-certs__p { font-size:13px; color:var(--slate); line-height:1.6; }

/* ── TRANSFER FORM ── */
#ot-root .ot-form-section { margin-bottom:24px; }
#ot-root .ot-form-section__hd { font-size:10px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--fog); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--ash); }
#ot-root .ot-selected-cert-preview { background:var(--bone); border-radius:13px; padding:16px; margin-bottom:24px; display:flex; align-items:center; gap:14px; }
#ot-root .ot-selected-cert-preview .ot-cert__edition { font-size:32px; margin-bottom:0; }
#ot-root .ot-selected-cert-preview__info { flex:1; }
#ot-root .ot-selected-cert-preview__title { font-size:13px; font-weight:700; color:var(--ink); }
#ot-root .ot-selected-cert-preview__type  { font-size:10px; color:var(--slate); margin-top:3px; }

/* ── PAYMENT SCREEN ── */
#ot-root .ot-payment-amount { text-align:center; margin:24px 0; }
#ot-root .ot-payment-amount__val { font-size:56px; font-weight:800; color:var(--ink); line-height:1; }
#ot-root .ot-payment-amount__lbl { font-size:11px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:var(--slate); margin-top:6px; }
#ot-root .ot-payment-note { background:#FEF9EC; border:1px solid rgba(196,154,24,.3); border-radius:12px; padding:14px 16px; font-size:12px; color:#92400E; line-height:1.6; margin-bottom:24px; }
#ot-root .ot-transfer-summary { background:var(--bone); border-radius:13px; padding:16px 18px; margin-bottom:20px; }
#ot-root .ot-transfer-summary__row { display:flex; justify-content:space-between; gap:12px; padding:6px 0; border-bottom:1px solid var(--ash); font-size:12px; }
#ot-root .ot-transfer-summary__row:last-child { border-bottom:none; }
#ot-root .ot-transfer-summary__row span:first-child { color:var(--slate); flex-shrink:0; }
#ot-root .ot-transfer-summary__row span:last-child  { font-weight:600; color:var(--ink); text-align:right; }

/* ── SUCCESS SCREEN ── */
#ot-root .ot-success-wrap { background:#000; min-height:100vh; min-height:100dvh; display:flex; align-items:center; justify-content:center; padding:40px 20px; }
#ot-root .ot-success__icon { width:80px; height:80px; background:rgba(22,163,74,.12); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 24px; }
#ot-root .ot-success__icon svg { width:36px; height:36px; color:#16a34a; }
#ot-root .ot-success__h { font-size:clamp(22px,3vw,32px); font-weight:800; color:#fff; text-align:center; margin-bottom:12px; }
#ot-root .ot-success__p { font-size:13px; color:rgba(255,255,255,.5); text-align:center; line-height:1.7; margin-bottom:8px; }
#ot-root .ot-success__steps { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:14px; padding:20px; margin:24px 0; }
#ot-root .ot-success__step { display:flex; gap:12px; align-items:flex-start; padding:8px 0; }
#ot-root .ot-success__step-n { width:22px; height:22px; border-radius:50%; background:var(--gold); color:#000; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:1px; }
#ot-root .ot-success__step-t { font-size:12px; color:rgba(255,255,255,.7); line-height:1.5; }

/* ── BACK BUTTON ── */
#ot-root .ot-back { display:inline-flex; align-items:center; gap:8px; background:none; border:none; cursor:pointer; font-size:10px; font-weight:700; letter-spacing:2.5px; text-transform:uppercase; padding:6px 0; margin-bottom:28px; transition:color .2s; }
#ot-root .ot-back svg { width:16px; height:16px; flex-shrink:0; transition:transform .25s var(--swift); }
#ot-root .ot-back:hover svg { transform:translateX(-4px); }
#ot-root .ot-back--lt { color:rgba(255,255,255,.4); } #ot-root .ot-back--lt:hover { color:#fff; }
#ot-root .ot-back--dk { color:var(--slate); } #ot-root .ot-back--dk:hover { color:var(--ink); }

/* ── LOADING ── */
#ot-root .ot-loading { display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:9999; flex-direction:column; align-items:center; justify-content:center; gap:16px; }
#ot-root .ot-loading.on { display:flex; }
#ot-root .ot-loading__ring { width:48px; height:48px; border:3px solid rgba(255,255,255,.15); border-top-color:var(--gold); border-radius:50%; animation:ot-spin .8s linear infinite; }
#ot-root .ot-loading__txt { font-size:13px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,.7); font-family:var(--font); }
#ot-root .ot-toast { position:fixed; bottom:28px; left:50%; transform:translateX(-50%); background:#111; color:#fff; border-radius:12px; padding:12px 20px; font-size:13px; font-weight:600; z-index:10000; min-width:220px; max-width:90vw; text-align:center; box-shadow:0 8px 32px rgba(0,0,0,.4); opacity:0; transition:opacity .3s; pointer-events:none; font-family:var(--font); }
#ot-root .ot-toast.on { opacity:1; }
#ot-root .ot-toast.ok  { border-top:3px solid #16a34a; }
#ot-root .ot-toast.err { border-top:3px solid var(--red); }
#ot-root .ot-toast.info{ border-top:3px solid var(--gold); }
</style>

<div id="ot-root">

