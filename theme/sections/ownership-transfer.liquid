<!-- Config -->
<script>
window.OTCfg = {
  firebase: {
    apiKey:            '{{ section.settings.firebase_api_key | escape }}',
    authDomain:        '{{ section.settings.firebase_auth_domain | escape }}',
    projectId:         '{{ section.settings.firebase_project_id | escape }}',
    appId:             '{{ section.settings.firebase_app_id | escape }}',
    messagingSenderId: '{{ section.settings.firebase_messaging_sender_id | escape }}'
  },
  apiBaseUrl:   '{{ section.settings.api_base_url | escape }}',
  transferFee:  {{ section.settings.transfer_fee | default: 499 }},
};
</script>

<!-- Firebase Compat SDKs (same version as auth portal) -->
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>

<script>
(function () {
  'use strict';

  var root = document.getElementById('ot-root');
  if (!root) return;
  var cfg = window.OTCfg || {};

  /* ── STATE ── */
  var S = {
    screen:         'phone',
    cc:             '+91',
    phone:          null,
    confirmResult:  null,
    fbUser:         null,
    idToken:        null,
    certs:          [],
    selectedCert:   null,
    resendTimer:    null,
    resendSecs:     30,
  };

  /* ── HELPERS ── */
  var fbAuth, rcVerifier;

  function $(id) { return document.getElementById(id); }
  function qsa(sel) { return root.querySelectorAll(sel); }

  function go(id) {
    if (id === S.screen) return;
    var from = root.querySelector('[data-screen="' + S.screen + '"]');
    var to   = root.querySelector('[data-screen="' + id + '"]');
    if (!to) return;
    if (from) { from.classList.add('is-leaving'); from.classList.remove('is-active'); setTimeout(function(){from.classList.remove('is-leaving');},280); }
    setTimeout(function(){ to.classList.add('is-active'); window.scrollTo({top:0,behavior:'instant'}); }, 150);
    S.screen = id;
  }

  var toastT;
  function toast(msg, type) {
    var el = $('ot-toast');
    if (!el) return;
    el.textContent = msg;
    el.className = 'ot-toast on ' + (type||'');
    clearTimeout(toastT);
    toastT = setTimeout(function(){ el.classList.remove('on'); }, 3500);
  }

  function showLoad(msg) {
    var el = $('ot-loading'); if(el) el.classList.add('on');
    var t = $('ot-loading-txt'); if(t) t.textContent = msg||'Please wait…';
  }
  function hideLoad() { var el = $('ot-loading'); if(el) el.classList.remove('on'); }
  function setBtn(id, disabled) { var el = $(id); if(el) el.disabled = disabled; }

  /* ── FIREBASE ── */
  function initFirebase() {
    if (!cfg.firebase || !cfg.firebase.apiKey) return false;
    try {
      // Use a named app to avoid conflict with the auth portal on the same page
      var existing = firebase.apps.find(function(a){ return a.name === 'ot-app'; });
      var app = existing || firebase.initializeApp(cfg.firebase, 'ot-app');
      fbAuth = app.auth();
      return true;
    } catch(e) { console.warn('[OT Firebase]', e.message); return false; }
  }

  /* ── PHONE / OTP ── */
  function handleSend() {
    var inp = $('ot-phone-input');
    var raw = (inp.value||'').replace(/\D/g,'');
    if (raw.length < 10) { inp.classList.add('err'); toast('Enter a valid 10-digit mobile number.','err'); setTimeout(function(){inp.classList.remove('err');},700); return; }
    S.phone = S.cc + raw;
    var ph = $('ot-otp-phone'); if(ph) ph.textContent = S.phone;
    showLoad('Sending verification code…');
    setBtn('ot-send-otp', true);
    sendOTP();
  }

  function sendOTP() {
    if (!fbAuth) {
      hideLoad(); setBtn('ot-send-otp', false);
      go('otp'); startResend();
      toast('Demo mode — enter any 6 digits','info');
      return;
    }
    if (!rcVerifier) {
      rcVerifier = new firebase.auth.RecaptchaVerifier('ot-recaptcha', { size:'invisible', callback:function(){} }, fbAuth.app);
    }
    fbAuth.signInWithPhoneNumber(S.phone, rcVerifier)
      .then(function(res){ S.confirmResult = res; hideLoad(); setBtn('ot-send-otp',false); go('otp'); startResend(); toast('Code sent!','ok'); })
      .catch(function(err){ hideLoad(); setBtn('ot-send-otp',false); toast(fbErr(err.code),'err'); if(rcVerifier){rcVerifier.clear();rcVerifier=null;} });
  }

  function startResend() {
    S.resendSecs = 30;
    var btn = $('ot-resend-btn'); var timer = $('ot-resend-timer');
    if(btn) btn.disabled = true;
    clearInterval(S.resendTimer);
    S.resendTimer = setInterval(function(){
      S.resendSecs--;
      if(timer) timer.textContent = S.resendSecs;
      if(S.resendSecs <= 0) { clearInterval(S.resendTimer); if(btn){btn.disabled=false;btn.textContent='Resend OTP';} }
    }, 1000);
  }

  function getOTP() { return Array.from(qsa('.ot-otp-box')).map(function(b){return b.value;}).join(''); }

  function handleVerify() {
    var code = getOTP();
    if (code.length !== 6) { qsa('.ot-otp-box').forEach(function(b){b.classList.add('err');setTimeout(function(){b.classList.remove('err');},600);}); toast('Enter all 6 digits.','err'); return; }
    showLoad('Verifying…');
    setBtn('ot-verify-otp', true);

    var doFetch = function(user) {
      S.fbUser = user;
      return user.getIdToken().then(function(tok){
        S.idToken = tok;
        return fetch(cfg.apiBaseUrl + '/transfer/lookup', {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + tok, 'Content-Type': 'application/json' }
        });
      }).then(function(r){ return r.json(); });
    };

    var proceed = function(user) {
      doFetch(user)
        .then(function(data){
          hideLoad(); setBtn('ot-verify-otp', false);
          S.certs = data.certificates || [];
          renderCerts(S.certs);
          go('certs');
        })
        .catch(function(e){ hideLoad(); setBtn('ot-verify-otp',false); toast('Error loading certificates. Try again.','err'); console.error(e); });
    };

    if (!S.confirmResult) {
      // Demo mode
      hideLoad(); setBtn('ot-verify-otp', false);
      S.certs = demoCerts();
      renderCerts(S.certs);
      go('certs');
      return;
    }

    S.confirmResult.confirm(code)
      .then(function(result){ proceed(result.user); })
      .catch(function(err){
        hideLoad(); setBtn('ot-verify-otp',false);
        qsa('.ot-otp-box').forEach(function(b){b.value='';b.classList.add('err');setTimeout(function(){b.classList.remove('err');},600);});
        var f = root.querySelector('.ot-otp-box'); if(f) f.focus();
        toast(fbErr(err.code||err.message),'err');
      });
  }

  function fbErr(code) {
    var m = { 'auth/invalid-phone-number':'Invalid phone number.','auth/too-many-requests':'Too many attempts. Try later.','auth/invalid-verification-code':'Incorrect code — please retry.','auth/code-expired':'Code expired. Please resend.' };
    return m[code] || 'Verification failed. Please retry.';
  }

  /* ── OTP BOX NAVIGATION ── */
  function initBoxes() {
    var boxes = Array.from(qsa('.ot-otp-box'));
    boxes.forEach(function(box, i){
      box.addEventListener('input', function(){
        var v = this.value.replace(/\D/g,''); this.value = v.slice(-1);
        if (v && i < boxes.length-1) boxes[i+1].focus();
      });
      box.addEventListener('keydown', function(e){
        if (e.key === 'Backspace' && !this.value && i > 0) boxes[i-1].focus();
        if (e.key === 'ArrowLeft'  && i > 0)               boxes[i-1].focus();
        if (e.key === 'ArrowRight' && i < boxes.length-1)  boxes[i+1].focus();
      });
      box.addEventListener('paste', function(e){
        e.preventDefault();
        var txt = (e.clipboardData||window.clipboardData).getData('text');
        var digits = txt.replace(/\D/g,'').slice(0,6);
        digits.split('').forEach(function(d,j){ if(boxes[j]) boxes[j].value=d; });
        var last = Math.min(digits.length, boxes.length-1);
        if(boxes[last]) boxes[last].focus();
      });
      box.addEventListener('focus', function(){ this.select(); });
    });
  }

  /* ── CERT RENDERING ── */
  function renderCerts(certs) {
    var grid = $('ot-certs-grid');
    var sub  = $('ot-certs-sub');
    if (!grid) return;

    if (!certs || certs.length === 0) {
      grid.innerHTML = '<div class="ot-no-certs"><div class="ot-no-certs__icon">📋</div><h3 class="ot-no-certs__h">No Certificates Found</h3><p class="ot-no-certs__p">We could not find any Artisan or Signed Edition certificates registered to ' + (S.phone||'your number') + '.<br><br>If you believe this is an error, please contact LEGXI support.</p></div>';
      if(sub) sub.textContent = 'No certificates found for this number.';
      return;
    }

    if(sub) sub.textContent = 'Found ' + certs.length + ' certificate' + (certs.length > 1 ? 's' : '') + '. Select one to transfer.';

    grid.innerHTML = certs.map(function(cert, i){
      var tc = parseInt(cert.transfer_count||'0',10);
      var typeLabel = (cert.edition_type||'').toLowerCase() === 'artisan' ? 'Artisan Edition' : 'Signed Edition';
      var typeClass = (cert.edition_type||'').toLowerCase() === 'artisan' ? 'ot-cert__type--artisan' : 'ot-cert__type--signed';
      var edNum = cert.edition_number || '---';
      var srcBadge = cert._source === 'registry'
        ? '<span style="font-size:10px;color:var(--gold);margin-left:6px;">● Registry</span>'
        : '';
      return '<div class="ot-cert" data-cert-index="' + i + '" tabindex="0" role="button" aria-label="Select ' + (cert.product_title||'certificate') + '">'
        + '<div class="ot-cert__select-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div>'
        + '<span class="ot-cert__type ' + typeClass + '">' + typeLabel + '</span>'
        + '<div class="ot-cert__edition">' + edNum + '</div>'
        + '<div class="ot-cert__title">' + esc(cert.product_title || 'Certificate') + srcBadge + '</div>'
        + '<div class="ot-cert__order">Order: ' + esc(cert.order_id || '—') + '</div>'
        + '<div class="ot-cert__owner-row">'
        +   '<div class="ot-cert__owner-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>'
        +   '<div><div class="ot-cert__owner-lbl">Current Owner</div><div class="ot-cert__owner-name">' + esc(cert.current_owner_name || 'You') + '</div></div>'
        + '</div>'
        + (tc > 0 ? '<div class="ot-cert__transfers">Transferred <strong>' + tc + '</strong> time' + (tc > 1 ? 's' : '') + '</div>' : '')
        + '</div>';
    }).join('');

    // Bind click events
    qsa('.ot-cert').forEach(function(card){
      var clickFn = function() {
        var idx = parseInt(card.dataset.certIndex, 10);
        S.selectedCert = certs[idx];
        qsa('.ot-cert').forEach(function(c){ c.classList.remove('is-selected'); });
        card.classList.add('is-selected');
        var nextBtn = $('ot-cert-next');
        if(nextBtn) nextBtn.disabled = false;
      };
      card.addEventListener('click', clickFn);
      card.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){e.preventDefault();clickFn();} });
    });
  }

  function esc(str) {
    return String(str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── CERT SELECTION → FORM ── */
  function showForm(cert) {
    if(!cert) return;
    var edEl = $('ot-form-cert-edition');
    var ttEl = $('ot-form-cert-title');
    var tyEl = $('ot-form-cert-type');
    if(edEl) edEl.textContent = cert.edition_number || '---';
    if(ttEl) ttEl.textContent = cert.product_title  || 'Certificate';
    if(tyEl) tyEl.textContent = (cert.edition_type||'').charAt(0).toUpperCase() + (cert.edition_type||'').slice(1) + ' Edition';
    go('form');
  }

  /* ── TRANSFER FORM SUBMIT ── */
  function handleTransferSubmit() {
    var name  = ($('ot-to-name').value  || '').trim();
    var phone = ($('ot-to-phone').value || '').trim();
    var email = ($('ot-to-email').value || '').trim();
    var reason= ($('ot-reason').value   || '').trim();
    var ok = true;

    if (!name)  { $('ot-to-name').classList.add('err');  ok = false; }
    if (!phone) { $('ot-to-phone').classList.add('err'); ok = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { $('ot-to-email').classList.add('err'); ok = false; }
    if (!ok) { toast('Please fill all required fields correctly.','err'); return; }

    ['ot-to-name','ot-to-phone','ot-to-email'].forEach(function(id){ var el = $(id); if(el) el.classList.remove('err'); });

    showLoad('Creating transfer request…');
    setBtn('ot-transfer-submit', true);

    var cert = S.selectedCert;
    var body = {
      certificate_id:      cert.certificate_id,
      certificate_handle:  cert.handle || null,
      to_name:             name,
      to_phone:            phone,
      to_email:            email,
      reason:              reason,
      // Pass original order data in case this is the first transfer (no registry record yet)
      original_owner_name:  cert.original_owner_name  || cert.current_owner_name  || '',
      original_owner_email: cert.original_owner_email || cert.current_owner_email || '',
      product_title:        cert.product_title  || '',
      edition_number:       cert.edition_number || '',
      edition_type:         cert.edition_type   || '',
      order_id:             cert.order_id       || '',
    };

    fetch(cfg.apiBaseUrl + '/transfer/request', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + S.idToken, 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
    .then(function(r){ return r.json().then(function(d){ return { ok: r.ok, data: d }; }); })
    .then(function(res){
      hideLoad(); setBtn('ot-transfer-submit', false);
      if (!res.ok) throw new Error(res.data.error || 'Failed to submit transfer request');
      go('success');
      setTimeout(function() { window.location.href = '/'; }, 5000);
    })
    .catch(function(e){ hideLoad(); setBtn('ot-transfer-submit',false); toast(e.message,'err'); });
  }

  /* ── DEMO DATA ── */
  function demoCerts() {
    return [{
      _source: 'order', certificate_id: 'campeones-world-cup-2022--050', edition_number: '#050',
      product_title: 'Campeones World Cup 2022 Edition', edition_type: 'artisan',
      order_id: '#1042', current_owner_name: 'Demo User', current_owner_phone: S.phone,
      current_owner_email: 'demo@legxi.co', transfer_count: '0', transfer_status: 'active',
    }];
  }

  /* ── INIT ── */
  function init() {
    initFirebase();
    initBoxes();

    // (Legacy payment logic removed)

    var sendBtn = $('ot-send-otp');
    if(sendBtn) sendBtn.addEventListener('click', handleSend);
    var phoneInp = $('ot-phone-input');
    if(phoneInp) phoneInp.addEventListener('keydown', function(e){ if(e.key==='Enter') handleSend(); });

    var verBtn = $('ot-verify-otp');
    if(verBtn) verBtn.addEventListener('click', handleVerify);
    var lastBox = qsa('.ot-otp-box');
    if(lastBox.length) lastBox[lastBox.length-1].addEventListener('keydown', function(e){ if(e.key==='Enter') handleVerify(); });

    var resendBtn = $('ot-resend-btn');
    if(resendBtn) resendBtn.addEventListener('click', function(){
      qsa('.ot-otp-box').forEach(function(b){b.value='';});
      var f=root.querySelector('.ot-otp-box'); if(f)f.focus();
      sendOTP();
    });

    var certNext = $('ot-cert-next');
    if(certNext) certNext.addEventListener('click', function(){ if(S.selectedCert) showForm(S.selectedCert); });

    var submitBtn = $('ot-transfer-submit');
    if(submitBtn) submitBtn.addEventListener('click', handleTransferSubmit);

    // Back buttons
    $('ot-back-otp')    && $('ot-back-otp').addEventListener('click',     function(){ go('phone'); });
    $('ot-back-certs')  && $('ot-back-certs').addEventListener('click',   function(){ go('phone'); });
    $('ot-back-form')   && $('ot-back-form').addEventListener('click',    function(){ go('certs'); });
  }

  init();
})();
</script>

