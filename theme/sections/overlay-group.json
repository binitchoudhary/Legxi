{
  "type": "custom.overlay",
  "name": "Overlay group",
  "sections": {
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "color_scheme": "scheme-1",
        "show_cart_note": true,
        "show_shipping_estimator": true,
        "show_shipping_text": true,
        "allow_discount_application": false,
        "show_terms_of_service_checkbox": true,
        "show_view_cart_button": true,
        "show_checkout_button": true,
        "enable_cross_sell": true,
        "cross_sell_title": "You may also like"
      }
    },
    "search-drawer": {
      "type": "search-drawer",
      "settings": {
        "color_scheme": "",
        "popular_searches_title": "Popular searches",
        "popular_searches_menu": "main-menu",
        "featured_products_title": "Featured products",
        "featured_products": []
      }
    }
  },
  "order": [
    "cart-drawer",
    "search-drawer"
  ]
}
