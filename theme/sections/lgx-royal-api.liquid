[
  {%- assign results = blank -%}
  {%- if search.performed -%}
    {%- assign results = search.results -%}
  {%- elsif recommendations.performed -%}
    {%- assign results = recommendations.products -%}
  {%- elsif collection -%}
    {%- assign results = collection.products -%}
  {%- endif -%}
  {%- assign first = true -%}
  {%- for p in results -%}
    {%- if p.object_type == 'product' or p.object_type == blank -%}
      {%- assign et = p.metafields.custom.edition_type.value | downcase -%}
      {%- if et != 'signed' -%}
        {%- if first == false -%},{%- endif -%}
        {
          "id": {{ p.id | json }},
          "handle": {{ p.handle | json }},
          "title": {{ p.title | json }},
          "price": {{ p.price | json }},
          "image": {% if p.featured_image != blank %}{{ p.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %},
          "variants": [
            {%- for v in p.variants -%}
              { "id": {{ v.id | json }}, "price": {{ v.price | json }} }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
        {%- assign first = false -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
]
