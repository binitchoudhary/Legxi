        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ownership Highlights",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "label_text": "TOTAL",
            "title_text": "84 Pieces"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "label_text": "PERSONALLY SIGNED BY",
            "title_text": "Lionel Messi & others"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "label_text": "CRAFTMANSHIP",
            "title_text": "Hand Finished"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "label_text": "PROVENANCE",
            "title_text": "Official Argentine Collection"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "label_text": "ONE LAST CHANCE",
