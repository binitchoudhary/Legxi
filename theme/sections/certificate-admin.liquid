{%- comment -%}
  LEGXI — Certificate Ownership Admin Panel
  Standalone protected page. Calls the transfer-api backend with admin token.
  Route: /pages/certificate-admin
{%- endcomment -%}

<style>
/* ── SHOPIFY ISOLATION ── */
.shopify-section:has(#ca-root),
.shopify-section > .section-{{ section.id }}:has(#ca-root) { max-width:none !important; padding:0 !important; margin:0 !important; width:100% !important; }
body:has(#ca-root) .shopify-section:not(:has(#ca-root)) { display:none !important; }
html:has(#ca-root), body:has(#ca-root) { margin:0 !important; padding:0 !important; background:#F5F5F7 !important; }

/* ── RESET ── */
#ca-root *, #ca-root *::before, #ca-root *::after { box-sizing:border-box; margin:0; padding:0; }
#ca-root button { -webkit-appearance:none; appearance:none; background:none; border:none; cursor:pointer; font-family:inherit; }
#ca-root input, #ca-root select, #ca-root textarea { -webkit-appearance:none; appearance:none; font-family:inherit; outline:none; border:none; background:none; }
#ca-root a { text-decoration:none; color:inherit; }

/* ── DESIGN TOKENS ── */
#ca-root {
  font-family:-apple-system,BlinkMacSystemFont,'Inter','Segoe UI',sans-serif;
  font-size:14px; line-height:1.5; color:#1a1a2e;
  -webkit-font-smoothing:antialiased;
  --blue:    #0066CC; --blue-lt:#E8F0FF;
  --green:   #16a34a; --green-lt:#DCFCE7;
  --amber:   #D97706; --amber-lt:#FEF9EC;
  --red:     #DC2626; --red-lt:#FEE2E2;
  --gold:    #C49A18; --gold-lt:#FFFCF0;
  --slate:   #6B7280;
  --border:  #E5E7EB;
  --shadow:  0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05);
  --shadow2: 0 4px 16px rgba(0,0,0,.10),0 2px 4px rgba(0,0,0,.05);
  isolation: isolate; min-height:100vh;
}

@keyframes ca-spin { to { transform:rotate(360deg); } }
@keyframes ca-fadeIn { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }

/* ── LOGIN SCREEN ── */
#ca-root .ca-login { min-height:100vh; display:flex; align-items:center; justify-content:center; background:#0A1628; padding:24px; }
#ca-root .ca-login__card { background:#fff; border-radius:20px; padding:48px 40px; width:100%; max-width:400px; box-shadow:0 24px 80px rgba(0,0,0,.3); position:relative; overflow:hidden; }
#ca-root .ca-login__card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,transparent,#C49A18 30%,#D4B030 50%,#C49A18 70%,transparent); }
#ca-root .ca-login__logo { font-size:11px; font-weight:700; letter-spacing:6px; text-transform:uppercase; color:#C49A18; text-align:center; margin-bottom:8px; }
#ca-root .ca-login__h { font-size:22px; font-weight:800; color:#1a1a2e; text-align:center; margin-bottom:6px; }
#ca-root .ca-login__sub { font-size:13px; color:#6B7280; text-align:center; margin-bottom:28px; }
#ca-root .ca-login__lbl { display:block; font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#9CA3AF; margin-bottom:8px; }
#ca-root .ca-login__input { width:100%; height:48px; padding:0 14px; background:#F9FAFB; border:1.5px solid #E5E7EB; border-radius:10px; font-size:15px; font-weight:500; color:#1a1a2e; transition:border-color .2s; margin-bottom:16px; display:block; }
#ca-root .ca-login__input:focus { border-color:#0A1628; }
#ca-root .ca-login__btn { width:100%; height:48px; background:#0A1628; color:#fff; border-radius:10px; font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; display:flex; align-items:center; justify-content:center; gap:8px; transition:background .2s; }
#ca-root .ca-login__btn:hover { background:#1a2d4a; }
#ca-root .ca-login__err { font-size:12px; color:#DC2626; text-align:center; margin-top:12px; min-height:18px; }

/* ── APP SHELL ── */
#ca-root .ca-app { display:flex; flex-direction:column; min-height:100vh; }
#ca-root .ca-header { background:#0A1628; padding:0 28px; height:60px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
#ca-root .ca-header__brand { font-size:13px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:#C49A18; }
#ca-root .ca-header__meta { font-size:11px; color:rgba(255,255,255,.4); display:flex; align-items:center; gap:16px; }
#ca-root .ca-header__logout { font-size:11px; font-weight:700; color:rgba(255,255,255,.5); cursor:pointer; letter-spacing:1px; text-transform:uppercase; transition:color .2s; }
#ca-root .ca-header__logout:hover { color:#fff; }

#ca-root .ca-main { flex:1; padding:28px; max-width:1200px; width:100%; margin:0 auto; }

/* ── STATS ── */
#ca-root .ca-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }
@media(max-width:720px) { #ca-root .ca-stats { grid-template-columns:repeat(2,1fr); } }
#ca-root .ca-stat { background:#fff; border-radius:12px; padding:18px; box-shadow:var(--shadow); border:1px solid var(--border); }
#ca-root .ca-stat__n { font-size:32px; font-weight:800; color:#1a1a2e; line-height:1; margin-bottom:4px; }
#ca-root .ca-stat__l { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:var(--slate); }

/* ── TOOLBAR ── */
#ca-root .ca-toolbar { background:#fff; border-radius:12px; padding:14px 18px; box-shadow:var(--shadow); border:1px solid var(--border); margin-bottom:18px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
#ca-root .ca-search { flex:1; min-width:220px; height:38px; padding:0 14px; background:#F9FAFB; border:1.5px solid var(--border); border-radius:8px; font-size:13px; color:#1a1a2e; transition:border-color .2s; }
#ca-root .ca-search:focus { border-color:#0A1628; }
#ca-root .ca-filter-tabs { display:flex; gap:8px; }
#ca-root .ca-tab { padding:6px 14px; border-radius:20px; font-size:12px; font-weight:600; border:1.5px solid transparent; cursor:pointer; transition:all .2s; }
#ca-root .ca-tab.active { background:#0A1628; color:#fff; }
#ca-root .ca-tab:not(.active) { background:#F3F4F6; color:var(--slate); border-color:#E5E7EB; }
#ca-root .ca-tab:not(.active):hover { border-color:#0A1628; color:#0A1628; }
#ca-root .ca-create-btn { padding:8px 16px; background:var(--gold); color:#1a1a2e; border-radius:8px; font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; display:flex; align-items:center; gap:6px; transition:background .2s; white-space:nowrap; }
#ca-root .ca-create-btn:hover { background:#D4B030; }

/* ── TABLE ── */
#ca-root .ca-table-wrap { background:#fff; border-radius:12px; box-shadow:var(--shadow); border:1px solid var(--border); overflow:hidden; }
#ca-root table { width:100%; border-collapse:collapse; }
#ca-root th { background:#F8F9FA; padding:10px 14px; text-align:left; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:var(--slate); border-bottom:1px solid var(--border); white-space:nowrap; }
#ca-root td { padding:12px 14px; border-bottom:1px solid #F9FAFB; font-size:13px; vertical-align:middle; }
#ca-root tr:last-child td { border-bottom:none; }
#ca-root tbody tr:hover td { background:#FAFAFA; }
#ca-root .ca-row-action { cursor:pointer; }

/* ── BADGES ── */
#ca-root .ca-badge { display:inline-block; padding:3px 10px; border-radius:10px; font-size:11px; font-weight:600; white-space:nowrap; }
#ca-root .ca-badge--active         { background:#DCFCE7; color:#166534; }
#ca-root .ca-badge--payment_pending{ background:#E0F2FE; color:#075985; }
#ca-root .ca-badge--pending        { background:#FEF9EC; color:#92400E; }
#ca-root .ca-badge--approved       { background:#DCFCE7; color:#166534; }
#ca-root .ca-badge--rejected       { background:#FEE2E2; color:#991B1B; }
#ca-root .ca-badge--artisan        { background:#FEF9EC; color:#92400E; }
#ca-root .ca-badge--signed         { background:#F0FDF4; color:#166534; }

/* ── ACTION BUTTONS (table) ── */
#ca-root .ca-action-wrap { display:flex; gap:6px; }
#ca-root .ca-action-btn { padding:5px 12px; border-radius:7px; font-size:11px; font-weight:700; letter-spacing:.5px; transition:all .2s; }
#ca-root .ca-action-btn--approve { background:var(--green-lt); color:var(--green); }
#ca-root .ca-action-btn--approve:hover { background:var(--green); color:#fff; }
#ca-root .ca-action-btn--reject  { background:var(--red-lt);   color:var(--red); }
#ca-root .ca-action-btn--reject:hover  { background:var(--red);   color:#fff; }
#ca-root .ca-action-btn--view    { background:#F3F4F6; color:var(--slate); }
#ca-root .ca-action-btn--view:hover    { background:#E5E7EB; color:#1a1a2e; }

/* ── EMPTY STATE ── */
#ca-root .ca-empty { text-align:center; padding:60px 20px; color:var(--slate); }
#ca-root .ca-empty__icon { font-size:40px; margin-bottom:12px; }
#ca-root .ca-empty__h { font-size:15px; font-weight:700; color:#1a1a2e; margin-bottom:4px; }

/* ── MODAL ── */
#ca-root .ca-modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:9998; align-items:center; justify-content:center; padding:20px; }
#ca-root .ca-modal-overlay.on { display:flex; animation:ca-fadeIn .25s ease both; }
#ca-root .ca-modal { background:#fff; border-radius:18px; width:100%; max-width:600px; max-height:90vh; overflow-y:auto; box-shadow:0 24px 80px rgba(0,0,0,.25); position:relative; }
#ca-root .ca-modal__hd { padding:22px 24px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }
#ca-root .ca-modal__title { font-size:16px; font-weight:800; color:#1a1a2e; }
#ca-root .ca-modal__close { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#F3F4F6; color:var(--slate); transition:background .2s; font-size:16px; line-height:1; }
#ca-root .ca-modal__close:hover { background:#E5E7EB; }
#ca-root .ca-modal__body { padding:22px 24px; }
#ca-root .ca-modal__actions { padding:16px 24px 20px; border-top:1px solid var(--border); display:flex; gap:10px; flex-wrap:wrap; }
#ca-root .ca-modal-btn { padding:10px 20px; border-radius:10px; font-size:12px; font-weight:700; letter-spacing:.8px; text-transform:uppercase; transition:all .2s; }
#ca-root .ca-modal-btn--approve { background:var(--green); color:#fff; }
#ca-root .ca-modal-btn--approve:hover { background:#15803d; }
#ca-root .ca-modal-btn--reject  { background:var(--red); color:#fff; }
#ca-root .ca-modal-btn--reject:hover  { background:#b91c1c; }
#ca-root .ca-modal-btn--save    { background:#0A1628; color:#fff; }
#ca-root .ca-modal-btn--cancel  { background:#F3F4F6; color:var(--slate); }

/* ── DETAIL ROWS ── */
#ca-root .ca-detail-section { margin-bottom:20px; }
#ca-root .ca-detail-section__hd { font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--slate); margin-bottom:10px; padding-bottom:6px; border-bottom:1px solid var(--border); }
#ca-root .ca-detail-row { display:flex; align-items:flex-start; gap:8px; padding:5px 0; font-size:13px; }
#ca-root .ca-detail-row__lbl { width:150px; flex-shrink:0; color:var(--slate); font-size:12px; }
#ca-root .ca-detail-row__val { font-weight:600; color:#1a1a2e; flex:1; word-break:break-all; }

/* ── EDIT FIELDS (modal) ── */
#ca-root .ca-edit-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:8px; }
@media(max-width:500px) { #ca-root .ca-edit-grid { grid-template-columns:1fr; } }
#ca-root .ca-edit-field label { display:block; font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#9CA3AF; margin-bottom:5px; }
#ca-root .ca-edit-field input, #ca-root .ca-edit-field select { width:100%; height:40px; padding:0 10px; background:#F9FAFB; border:1.5px solid var(--border); border-radius:8px; font-size:13px; color:#1a1a2e; transition:border-color .2s; }
#ca-root .ca-edit-field input:focus, #ca-root .ca-edit-field select:focus { border-color:#0A1628; }

/* ── HISTORY TIMELINE ── */
#ca-root .ca-history-section { margin-top:8px; }
#ca-root .ca-history-loading { color:var(--slate); font-size:12px; padding:12px 0; }
#ca-root .ca-history-empty   { color:var(--slate); font-size:12px; font-style:italic; padding:8px 0; }
#ca-root .ca-timeline { position:relative; padding-left:28px; }
#ca-root .ca-timeline::before { content:''; position:absolute; left:10px; top:8px; bottom:8px; width:2px; background:var(--border); border-radius:1px; }
#ca-root .ca-tl-item { position:relative; margin-bottom:20px; }
#ca-root .ca-tl-item:last-child { margin-bottom:0; }
#ca-root .ca-tl-dot { position:absolute; left:-22px; top:2px; width:14px; height:14px; border-radius:50%; background:#0A1628; border:2px solid #fff; box-shadow:0 0 0 2px var(--border); flex-shrink:0; }
#ca-root .ca-tl-dot--first { background:var(--gold); box-shadow:0 0 0 2px rgba(196,154,24,.2); }
#ca-root .ca-tl-date { font-size:10px; font-weight:700; letter-spacing:.8px; color:var(--slate); text-transform:uppercase; margin-bottom:6px; }
#ca-root .ca-tl-card { background:#F9FAFB; border:1px solid var(--border); border-radius:10px; padding:12px 14px; }
#ca-root .ca-tl-card__from-to { display:flex; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap; }
#ca-root .ca-tl-card__owner { font-size:13px; }
#ca-root .ca-tl-card__owner strong { display:block; font-weight:700; color:#1a1a2e; }
#ca-root .ca-tl-card__owner span  { font-size:11px; color:var(--slate); }
#ca-root .ca-tl-card__arrow { color:var(--gold); font-size:18px; flex-shrink:0; }
#ca-root .ca-tl-card__meta { display:flex; gap:16px; margin-top:6px; padding-top:6px; border-top:1px solid var(--border); flex-wrap:wrap; }
#ca-root .ca-tl-card__meta-item { font-size:11px; color:var(--slate); }
#ca-root .ca-tl-card__meta-item strong { color:#1a1a2e; }

/* ── LOADING + TOAST ── */
#ca-root .ca-loading-bar { position:fixed; top:0; left:0; right:0; height:3px; background:var(--gold); transform:scaleX(0); transform-origin:left; transition:transform .3s; z-index:10000; }
#ca-root .ca-loading-bar.on { animation:ca-spin 1s linear infinite; transform:scaleX(.5); }
#ca-root .ca-toast { position:fixed; bottom:24px; right:24px; padding:12px 18px; background:#1a1a2e; color:#fff; border-radius:10px; font-size:13px; font-weight:600; box-shadow:var(--shadow2); z-index:10001; opacity:0; transition:opacity .3s; pointer-events:none; min-width:200px; max-width:380px; }
#ca-root .ca-toast.on { opacity:1; }
#ca-root .ca-toast.ok  { border-left:3px solid var(--green); }
#ca-root .ca-toast.err { border-left:3px solid var(--red); }

/* ── RESPONSIVE TABLE ── */
@media(max-width:768px) {
  #ca-root .ca-main { padding:16px; }
  #ca-root .ca-hide-sm { display:none; }
  #ca-root .ca-stats { grid-template-columns:1fr 1fr; }
}
</style>

<div id="ca-root">

  <!-- LOGIN SCREEN -->
  <div id="ca-login-screen">
    <div class="ca-login">
      <div class="ca-login__card">
        <div class="ca-login__logo">LEGXI</div>
        <h1 class="ca-login__h">Certificate Admin</h1>
        <p class="ca-login__sub">Enter your admin password to access the ownership transfer dashboard.</p>
        <label class="ca-login__lbl" for="ca-pwd-input">Admin Password</label>
        <input type="password" id="ca-pwd-input" class="ca-login__input" placeholder="Enter password" autocomplete="current-password">
        <button id="ca-login-btn" class="ca-login__btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
          Sign In
        </button>
        <p class="ca-login__err" id="ca-login-err"></p>
      </div>
    </div>
  </div>

  <!-- APP DASHBOARD -->
  <div id="ca-app-screen" style="display:none;">
    <div class="ca-app">
      <header class="ca-header">
        <div class="ca-header__brand">LEGXI Ownership Registry</div>
        <div class="ca-header__meta">
          <span id="ca-last-refresh" style="display:none;">Refreshed just now</span>
          <button class="ca-header__logout" id="ca-logout-btn">Sign Out</button>
        </div>
      </header>
      <main class="ca-main">
        <!-- Stats -->
        <div class="ca-stats" id="ca-stats">
          <div class="ca-stat"><div class="ca-stat__n" id="stat-total">—</div><div class="ca-stat__l">Total Records</div></div>
          <div class="ca-stat"><div class="ca-stat__n" id="stat-pending" style="color:#D97706;">—</div><div class="ca-stat__l">Pending Approval</div></div>
          <div class="ca-stat"><div class="ca-stat__n" id="stat-approved" style="color:#16a34a;">—</div><div class="ca-stat__l">Approved Transfers</div></div>
          <div class="ca-stat"><div class="ca-stat__n" id="stat-active" style="color:#0066CC;">—</div><div class="ca-stat__l">Active (No Pending)</div></div>
        </div>

        <!-- Toolbar -->
        <div class="ca-toolbar">
          <input type="search" id="ca-search" class="ca-search" placeholder="Search by edition, product, name, phone…">
          <div class="ca-filter-tabs">
            <button class="ca-tab active" data-filter="all">All</button>
            <button class="ca-tab" data-filter="pending">Pending</button>
            <button class="ca-tab" data-filter="active">Active</button>
            <button class="ca-tab" data-filter="approved">Approved</button>
            <button class="ca-tab" data-filter="rejected">Rejected</button>
          </div>
          <button class="ca-create-btn" id="ca-create-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Record
          </button>
          <button class="ca-action-btn ca-action-btn--view" id="ca-refresh-btn" title="Refresh">↺ Refresh</button>
        </div>

        <!-- Table -->
        <div class="ca-table-wrap">
          <table>
            <thead>
              <tr>
                <th>Edition</th>
                <th>Certificate / Product</th>
                <th>Current Owner</th>
                <th class="ca-hide-sm">Original Owner</th>
                <th>Status</th>
                <th class="ca-hide-sm">Transfers</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="ca-table-body">
              <tr><td colspan="7"><div class="ca-empty"><div class="ca-empty__icon">⏳</div><div class="ca-empty__h">Loading…</div></div></td></tr>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>

  <!-- DETAIL / EDIT MODAL -->
  <div class="ca-modal-overlay" id="ca-modal">
    <div class="ca-modal">
      <div class="ca-modal__hd">
        <div class="ca-modal__title" id="ca-modal-title">Transfer Details</div>
        <button class="ca-modal__close" id="ca-modal-close">✕</button>
      </div>
      <div class="ca-modal__body" id="ca-modal-body"><!-- JS fills --></div>
      <div class="ca-modal__actions" id="ca-modal-actions"><!-- JS fills --></div>
    </div>
  </div>

  <!-- CREATE RECORD MODAL -->
  <div class="ca-modal-overlay" id="ca-create-modal">
    <div class="ca-modal">
      <div class="ca-modal__hd">
        <div class="ca-modal__title">Add Ownership Record Manually</div>
        <button class="ca-modal__close" id="ca-create-close">✕</button>
      </div>
      <div class="ca-modal__body">
        <p style="font-size:12px;color:#6B7280;margin-bottom:16px;">Use this form to register ownership for historical orders, offline sales, or manual corrections. The original Shopify order is not modified.</p>
        <div class="ca-edit-grid">
          <div class="ca-edit-field" style="grid-column:1/-1;">
            <label for="cr-cert-id">Certificate ID <span style="color:#DC2626;">*</span></label>
            <input type="text" id="cr-cert-id" placeholder="e.g. campeones-world-cup-2022--050">
          </div>
          <div class="ca-edit-field">
            <label for="cr-edition-num">Edition Number</label>
            <input type="text" id="cr-edition-num" placeholder="#050">
          </div>
          <div class="ca-edit-field">
            <label for="cr-edition-type">Edition Type</label>
            <select id="cr-edition-type"><option value="">Select…</option><option value="artisan">Artisan</option><option value="signed">Signed</option></select>
          </div>
          <div class="ca-edit-field" style="grid-column:1/-1;">
            <label for="cr-product-title">Product Title</label>
            <input type="text" id="cr-product-title" placeholder="e.g. Campeones World Cup 2022 Edition">
          </div>
          <div class="ca-edit-field">
            <label for="cr-order-id">Order ID / Number</label>
            <input type="text" id="cr-order-id" placeholder="#1042">
          </div>
          <div class="ca-edit-field">
            <label for="cr-owner-name">Owner Name <span style="color:#DC2626;">*</span></label>
            <input type="text" id="cr-owner-name" placeholder="Full name">
          </div>
          <div class="ca-edit-field">
            <label for="cr-owner-phone">Owner Phone <span style="color:#DC2626;">*</span></label>
            <input type="tel" id="cr-owner-phone" placeholder="+91XXXXXXXXXX">
          </div>
          <div class="ca-edit-field">
            <label for="cr-owner-email">Owner Email</label>
            <input type="email" id="cr-owner-email" placeholder="owner@example.com">
          </div>
        </div>
      </div>
      <div class="ca-modal__actions">
        <button class="ca-modal-btn ca-modal-btn--save" id="cr-save-btn">Create Record</button>
        <button class="ca-modal-btn ca-modal-btn--cancel" id="ca-create-cancel">Cancel</button>
      </div>
    </div>
  </div>

  <!-- LOADING BAR + TOAST -->
  <div class="ca-loading-bar" id="ca-loading-bar"></div>
  <div class="ca-toast" id="ca-toast"></div>

</div><!-- /#ca-root -->

<script>
window.CACfg = {
  apiBaseUrl: '{{ section.settings.api_base_url | escape }}',
};
</script>

<script>
(function () {
  'use strict';

  var cfg = window.CACfg || {};
  var API = cfg.apiBaseUrl || '';

  /* ── STATE ── */
  var S = {
    token:    null,
    all:      [],
    filtered: [],
    filter:   'all',
    search:   '',
    selectedRecord: null,
  };

  /* ── HELPERS ── */
  function $(id)  { return document.getElementById(id); }
  function qsa(sel, ctx) { return (ctx||document).querySelectorAll(sel); }
  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function cap(s) { s = String(s||''); return s.charAt(0).toUpperCase()+s.slice(1).replace(/_/g,' '); }

  var toastT;
  function toast(msg, type) {
    var el = $('ca-toast'); if(!el) return;
    el.textContent = msg; el.className = 'ca-toast on '+(type||'');
    clearTimeout(toastT); toastT = setTimeout(function(){ el.classList.remove('on'); }, 3500);
  }
  function loading(on) { var el = $('ca-loading-bar'); if(el){ el.className = 'ca-loading-bar'+(on?' on':''); } }

  /* ── AUTH ── */
  function handleLogin() {
    var pwd = ($('ca-pwd-input').value||'').trim();
    var err = $('ca-login-err');
    if (!pwd) { if(err) err.textContent='Enter your password.'; return; }

    loading(true);
    if(err) err.textContent = '';

    fetch(API + '/admin/transfers?admin_token=' + encodeURIComponent(pwd) + '&limit=1')
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok, d:d}; }); })
      .then(function(res){
        loading(false);
        if (!res.ok) {
          if(err) err.textContent = 'Incorrect password. Please try again.';
          return;
        }
        S.token = pwd;
        try { sessionStorage.setItem('ca_token', pwd); } catch(e){}
        $('ca-login-screen').style.display = 'none';
        $('ca-app-screen').style.display = '';
        loadTransfers();
      })
      .catch(function(){ loading(false); if(err) err.textContent='Connection error. Check API URL in section settings.'; });
  }

  function handleLogout() {
    S.token = null;
    try { sessionStorage.removeItem('ca_token'); } catch(e){}
    $('ca-login-screen').style.display = '';
    $('ca-app-screen').style.display = 'none';
    $('ca-pwd-input').value = '';
  }

  /* ── DATA ── */
  function loadTransfers() {
    loading(true);
    fetch(API + '/admin/transfers', { headers: { 'X-Admin-Token': S.token } })
      .then(function(r){ return r.json(); })
      .then(function(d){
        loading(false);
        S.all = d.transfers || [];
        updateStats();
        applyFilter();
        var el = $('ca-last-refresh');
        if(el){ el.style.display=''; el.textContent='Refreshed '+new Date().toLocaleTimeString(); }
      })
      .catch(function(e){ loading(false); toast('Failed to load records: '+e.message,'err'); });
  }

  function updateStats() {
    var t = S.all.length;
    var pending  = S.all.filter(function(r){ return r.transfer_status==='pending'||r.transfer_status==='payment_pending'; }).length;
    var approved = S.all.filter(function(r){ return r.transfer_status==='approved'; }).length;
    var active   = S.all.filter(function(r){ return r.transfer_status==='active'; }).length;
    $('stat-total')   && ($('stat-total').textContent   = t);
    $('stat-pending') && ($('stat-pending').textContent = pending);
    $('stat-approved')&& ($('stat-approved').textContent= approved);
    $('stat-active')  && ($('stat-active').textContent  = active);
  }

  function applyFilter() {
    var s = (S.search||'').toLowerCase();
    S.filtered = S.all.filter(function(r){
      var statusOk = S.filter==='all' || r.transfer_status===S.filter;
      if (!statusOk) return false;
      if (!s) return true;
      return [r.certificate_id,r.edition_number,r.product_title,r.current_owner_name,r.current_owner_phone,r.original_owner_name,r.original_owner_phone].some(function(v){ return (v||'').toLowerCase().includes(s); });
    });
    renderTable();
  }

  /* ── TABLE ── */
  function statusBadge(st) {
    var labels = { active:'Active', payment_pending:'Awaiting Payment', pending:'Pending Approval', approved:'Approved', rejected:'Rejected' };
    return '<span class="ca-badge ca-badge--'+esc(st)+'">'+(labels[st]||cap(st))+'</span>';
  }
  function typeBadge(t) {
    if (!t) return '—';
    return '<span class="ca-badge ca-badge--'+esc(t)+'">'+(t.charAt(0).toUpperCase()+t.slice(1))+'</span>';
  }

  function renderTable() {
    var tbody = $('ca-table-body');
    if (!tbody) return;

    if (!S.filtered.length) {
      tbody.innerHTML = '<tr><td colspan="7"><div class="ca-empty"><div class="ca-empty__icon">📋</div><div class="ca-empty__h">No records found</div></div></td></tr>';
      return;
    }

    tbody.innerHTML = S.filtered.map(function(r){
      var hasAction = r.transfer_status === 'pending';
      return '<tr class="ca-row-action" data-handle="'+esc(r.handle)+'">'
        +'<td><strong>'+esc(r.edition_number||'—')+'</strong><br><small style="color:#9CA3AF;font-size:11px;">'+typeBadge(r.edition_type)+'</small></td>'
        +'<td style="max-width:220px;"><div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'+esc(r.product_title||'—')+'</div><div style="font-size:11px;color:#9CA3AF;margin-top:2px;">'+esc(r.certificate_id||'')+'</div></td>'
        +'<td><div style="font-weight:600;">'+esc(r.current_owner_name||'—')+'</div><div style="font-size:11px;color:#6B7280;">'+esc(r.current_owner_phone||'')+'</div></td>'
        +'<td class="ca-hide-sm"><div>'+esc(r.original_owner_name||'—')+'</div><div style="font-size:11px;color:#9CA3AF;">'+esc(r.original_owner_phone||'')+'</div></td>'
        +'<td>'+statusBadge(r.transfer_status||'active')+'</td>'
        +'<td class="ca-hide-sm" style="text-align:center;">'+(r.transfer_count||'0')+'</td>'
        +'<td><div class="ca-action-wrap">'
        +(hasAction
          ? '<button class="ca-action-btn ca-action-btn--approve" data-action="approve" data-handle="'+esc(r.handle)+'">Approve</button>'
           +'<button class="ca-action-btn ca-action-btn--reject"  data-action="reject"  data-handle="'+esc(r.handle)+'">Reject</button>'
          : '')
        +'<button class="ca-action-btn ca-action-btn--view" data-action="view" data-handle="'+esc(r.handle)+'">View</button>'
        +'</div></td>'
        +'</tr>';
    }).join('');

    // Bind action buttons
    qsa('.ca-action-btn', tbody).forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        var handle = btn.dataset.handle;
        var action = btn.dataset.action;
        var record = S.all.find(function(r){ return r.handle===handle; });
        if (!record) return;
        if (action === 'view')    { openDetailModal(record); }
        if (action === 'approve') { doAction(record, 'approve'); }
        if (action === 'reject')  { doAction(record, 'reject'); }
      });
    });

    // Row click opens detail
    qsa('tr.ca-row-action', tbody).forEach(function(row){
      row.addEventListener('click', function(e){
        if (e.target.closest('.ca-action-btn')) return;
        var handle = row.dataset.handle;
        var record = S.all.find(function(r){ return r.handle===handle; });
        if (record) openDetailModal(record);
      });
    });
  }

  /* ── MODALS ── */
  function openDetailModal(r) {
    S.selectedRecord = r;
    var body    = $('ca-modal-body');
    var actions = $('ca-modal-actions');
    var title   = $('ca-modal-title');
    if (title) title.textContent = 'Certificate ' + (r.edition_number||'') + ' — ' + (r.product_title||'');

    if (body) {
      body.innerHTML = [
        detailSection('Certificate', [
          ['Certificate ID',  r.certificate_id],
          ['Edition Number',  r.edition_number],
          ['Product Title',   r.product_title],
          ['Edition Type',    cap(r.edition_type)],
          ['Original Order',  r.order_id],
          ['Status',          cap(r.transfer_status)],
          ['Transfer Count',  r.transfer_count || '0'],
        ]),
        detailSection('Current Owner', [
          ['Name',  r.current_owner_name],
          ['Phone', r.current_owner_phone],
          ['Email', r.current_owner_email],
        ]),
        detailSection('Original Owner', [
          ['Name',  r.original_owner_name],
          ['Phone', r.original_owner_phone],
          ['Email', r.original_owner_email],
        ]),
        (r.pending_to_phone ? detailSection('Pending Transfer To', [
          ['Name',     r.pending_to_name],
          ['Phone',    r.pending_to_phone],
          ['Email',    r.pending_to_email],
          ['Reason',   r.transfer_reason || '—'],
          ['Draft Order', r.pending_order_id || '—'],
        ]) : ''),
        // Edit fields section
        '<div class="ca-detail-section"><div class="ca-detail-section__hd">Edit Ownership Directly (Admin Override)</div>'
        + '<div class="ca-edit-grid" id="ca-edit-grid">'
        + editField('edit-curr-name',  'Current Owner Name',  r.current_owner_name)
        + editField('edit-curr-phone', 'Current Owner Phone', r.current_owner_phone)
        + editField('edit-curr-email', 'Current Owner Email', r.current_owner_email)
        + editField('edit-status',     'Status',              r.transfer_status, ['active','pending','approved','rejected'])
        + '</div></div>',
        // Transfer history section — populated async after modal opens
        '<div class="ca-detail-section"><div class="ca-detail-section__hd">Transfer History</div>'
        + '<div id="ca-hist-body"><div style="color:#9CA3AF;font-size:13px;padding:8px 0;">Loading history…</div></div>'
        + '</div>',
      ].join('');
    }

    if (actions) {
      var btns = '';
      if (r.transfer_status === 'pending') {
        btns += '<button class="ca-modal-btn ca-modal-btn--approve" id="ma-approve">Approve Transfer</button>';
        btns += '<button class="ca-modal-btn ca-modal-btn--reject"  id="ma-reject">Reject Transfer</button>';
      }
      btns += '<button class="ca-modal-btn ca-modal-btn--save"   id="ma-save">Save Edits</button>';
      btns += '<button class="ca-modal-btn ca-modal-btn--cancel" id="ma-cancel">Close</button>';
      actions.innerHTML = btns;
      $('ma-approve') && $('ma-approve').addEventListener('click', function(){ doAction(r,'approve'); closeModal('ca-modal'); });
      $('ma-reject')  && $('ma-reject').addEventListener('click',  function(){ doAction(r,'reject');  closeModal('ca-modal'); });
      $('ma-save')    && $('ma-save').addEventListener('click',    function(){ doEdit(r); });
      $('ma-cancel')  && $('ma-cancel').addEventListener('click',  function(){ closeModal('ca-modal'); });
    }

    $('ca-modal').classList.add('on');

    // Async: fetch and render transfer history timeline
    if (r.certificate_id) {
      fetch(API + '/admin/history/' + encodeURIComponent(r.certificate_id), {
        headers: { 'X-Admin-Token': S.token }
      })
      .then(function(res){ return res.ok ? res.json() : { history: [] }; })
      .then(function(data){
        var histBody = $('ca-hist-body');
        if (!histBody) return;
        var items = data.history || [];
        if (!items.length) {
          histBody.innerHTML = '<div style="color:#9CA3AF;font-size:13px;padding:8px 0;">No transfer history yet.</div>';
          return;
        }
        histBody.innerHTML = '<div class="ca-timeline">'
          + items.map(function(item, idx){
              var d   = item.transfer_date ? new Date(item.transfer_date) : null;
              var date = d ? d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—';
              var time = d ? d.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) : '';
              return '<div class="ca-tl-item">'
                + '<div class="ca-tl-dot'+(idx===0?' ca-tl-dot--first':'')+'"></div>'
                + '<div class="ca-tl-date">'+esc(date)+(time?' · '+esc(time):'')+'</div>'
                + '<div class="ca-tl-card">'
                +   '<div class="ca-tl-card__from-to">'
                +     '<div><div style="font-size:11px;color:#9CA3AF;margin-bottom:2px;">FROM</div>'
                +       '<div style="font-weight:600;font-size:13px;">'+esc(item.old_owner_name||'—')+'</div>'
                +       '<div style="font-size:11px;color:#6B7280;">'+esc(item.old_owner_phone||'')+'</div></div>'
                +     '<div class="ca-tl-card__arrow">→</div>'
                +     '<div><div style="font-size:11px;color:#9CA3AF;margin-bottom:2px;">TO</div>'
                +       '<div style="font-weight:600;font-size:13px;">'+esc(item.new_owner_name||'—')+'</div>'
                +       '<div style="font-size:11px;color:#6B7280;">'+esc(item.new_owner_phone||'')+'</div></div>'
                +   '</div>'
                +   '<div class="ca-tl-card__meta">'
                +     (item.transfer_fee ? '<span>Fee: ₹'+esc(String(item.transfer_fee))+'</span>' : '')
                +     (item.approved_by  ? '<span>Approved by: '+esc(item.approved_by)+'</span>'  : '')
                +   '</div>'
                + '</div>'
                + '</div>';
            }).join('')
          + '</div>';
      })
      .catch(function(){
        var histBody = $('ca-hist-body');
        if (histBody) histBody.innerHTML = '<div style="color:#9CA3AF;font-size:13px;padding:8px 0;">History unavailable.</div>';
      });
    }
  }

  function detailSection(title, rows) {
    return '<div class="ca-detail-section"><div class="ca-detail-section__hd">'+esc(title)+'</div>'
      + rows.map(function(r){ return '<div class="ca-detail-row"><div class="ca-detail-row__lbl">'+esc(r[0])+'</div><div class="ca-detail-row__val">'+esc(r[1]||'—')+'</div></div>'; }).join('')
      + '</div>';
  }

  function editField(id, label, val, options) {
    if (options) {
      return '<div class="ca-edit-field"><label for="'+id+'">'+esc(label)+'</label>'
        +'<select id="'+id+'">'
        +options.map(function(o){ return '<option value="'+esc(o)+'"'+(o===val?' selected':'')+'>'+esc(cap(o))+'</option>'; }).join('')
        +'</select></div>';
    }
    return '<div class="ca-edit-field"><label for="'+id+'">'+esc(label)+'</label><input type="text" id="'+id+'" value="'+esc(val||'')+'"></div>';
  }

  function closeModal(id) { var m = $(id); if(m) m.classList.remove('on'); }

  /* ── ACTIONS ── */
  function doAction(record, action) {
    loading(true);
    fetch(API + '/admin/transfers/' + encodeURIComponent(record.handle), {
      method: 'PUT',
      headers: { 'X-Admin-Token': S.token, 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: action }),
    })
    .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
    .then(function(res){
      loading(false);
      if (!res.ok) throw new Error(res.d.error || 'Action failed');
      toast(action === 'approve' ? 'Transfer approved. Ownership updated.' : 'Transfer rejected.', action==='approve'?'ok':'err');
      loadTransfers();
    })
    .catch(function(e){ loading(false); toast(e.message,'err'); });
  }

  function doEdit(record) {
    var name  = ($('edit-curr-name')  && $('edit-curr-name').value.trim())  || '';
    var phone = ($('edit-curr-phone') && $('edit-curr-phone').value.trim()) || '';
    var email = ($('edit-curr-email') && $('edit-curr-email').value.trim()) || '';
    var status= ($('edit-status')     && $('edit-status').value)            || '';

    loading(true);
    fetch(API + '/admin/transfers/' + encodeURIComponent(record.handle), {
      method: 'PUT',
      headers: { 'X-Admin-Token': S.token, 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'edit', fields: {
        current_owner_name:  name,
        current_owner_phone: phone,
        current_owner_email: email,
        transfer_status:     status,
        updated_at:          new Date().toISOString(),
      }}),
    })
    .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
    .then(function(res){
      loading(false);
      if (!res.ok) throw new Error(res.d.error || 'Save failed');
      toast('Ownership record updated.','ok');
      closeModal('ca-modal');
      loadTransfers();
    })
    .catch(function(e){ loading(false); toast(e.message,'err'); });
  }

  function doCreate() {
    var certId  = ($('cr-cert-id').value||'').trim();
    var ownerPhone = ($('cr-owner-phone').value||'').trim();
    if (!certId || !ownerPhone) { toast('Certificate ID and Owner Phone are required.','err'); return; }

    loading(true);
    fetch(API + '/admin/transfers', {
      method: 'POST',
      headers: { 'X-Admin-Token': S.token, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        certificate_id:  certId,
        edition_number:  ($('cr-edition-num').value||'').trim(),
        edition_type:    $('cr-edition-type').value||'',
        product_title:   ($('cr-product-title').value||'').trim(),
        order_id:        ($('cr-order-id').value||'').trim(),
        owner_name:      ($('cr-owner-name').value||'').trim(),
        owner_phone:     ownerPhone,
        owner_email:     ($('cr-owner-email').value||'').trim(),
      }),
    })
    .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
    .then(function(res){
      loading(false);
      if (!res.ok) throw new Error(res.d.error || 'Create failed');
      toast('Ownership record created.','ok');
      closeModal('ca-create-modal');
      loadTransfers();
    })
    .catch(function(e){ loading(false); toast(e.message,'err'); });
  }

  /* ── INIT ── */
  function init() {
    // Auto-login from session
    try {
      var saved = sessionStorage.getItem('ca_token');
      if (saved) {
        S.token = saved;
        $('ca-login-screen').style.display = 'none';
        $('ca-app-screen').style.display = '';
        loadTransfers();
      }
    } catch(e){}

    $('ca-login-btn')  && $('ca-login-btn').addEventListener('click', handleLogin);
    $('ca-pwd-input')  && $('ca-pwd-input').addEventListener('keydown', function(e){ if(e.key==='Enter') handleLogin(); });
    $('ca-logout-btn') && $('ca-logout-btn').addEventListener('click', handleLogout);
    $('ca-refresh-btn')&& $('ca-refresh-btn').addEventListener('click', loadTransfers);
    $('ca-modal-close')&& $('ca-modal-close').addEventListener('click', function(){ closeModal('ca-modal'); });
    $('ca-create-btn') && $('ca-create-btn').addEventListener('click', function(){ $('ca-create-modal').classList.add('on'); });
    $('ca-create-close')&&$('ca-create-close').addEventListener('click',function(){ closeModal('ca-create-modal'); });
    $('ca-create-cancel')&&$('ca-create-cancel').addEventListener('click',function(){ closeModal('ca-create-modal'); });
    $('cr-save-btn')   && $('cr-save-btn').addEventListener('click', doCreate);

    // Close modals on overlay click
    [$('ca-modal'),$('ca-create-modal')].forEach(function(m){
      m && m.addEventListener('click', function(e){ if(e.target===m) m.classList.remove('on'); });
    });

    // Filter tabs
    qsa('.ca-tab').forEach(function(tab){
      tab.addEventListener('click', function(){
        qsa('.ca-tab').forEach(function(t){ t.classList.remove('active'); });
        tab.classList.add('active');
        S.filter = tab.dataset.filter || 'all';
        applyFilter();
      });
    });

    // Search with debounce
    var searchT;
    $('ca-search') && $('ca-search').addEventListener('input', function(){
      clearTimeout(searchT);
      var v = this.value;
      searchT = setTimeout(function(){ S.search = v; applyFilter(); }, 280);
    });
  }

  init();
})();
</script>

{% schema %}
{
  "name": "Certificate Admin",
  "settings": [
    { "type": "header", "content": "Backend API" },
    { "type": "text", "id": "api_base_url", "label": "Transfer API Base URL", "placeholder": "https://your-app.vercel.app", "info": "Same URL as set in the Ownership Transfer section. No trailing slash." }
  ],
  "presets": [{ "name": "Certificate Admin" }]
}
{% endschema %}
