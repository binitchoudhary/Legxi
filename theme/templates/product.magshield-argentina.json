    "faq_QdmdQY": {
      "type": "faq",
      "blocks": {
        "question_pTNYMY": {
          "type": "question",
          "settings": {
            "question": "What is a LEGXI MagShield?",
            "answer": "<p>LEGXI MagShield is a premium stainless steel football collectible designed to magnetically attach to your iPhone or compatible magnetic phone case. It allows you to carry iconic football moments with you every day.<br\/><\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_jgXHYU": {
          "type": "question",
          "settings": {
            "question": "Is this an officially licensed product?",
            "answer": "<p>Yes. The Argentina Edition is created under LEGXI's official licensing partnership with Argentina Football Association.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_Yy9gTR": {
          "type": "question",
          "settings": {
            "question": "What is included in the Argentina Edition?",
            "answer": "<p>The Argentina Edition includes a complete set of three MagShields:<\/p><p>•⁠  <strong>⁠Lionel Messi<\/strong> #10<br\/>•⁠  ⁠<strong>Emiliano Martínez<\/strong> #23<br\/>•⁠  ⁠<strong>Julián Álvarez<\/strong> #9<br\/><\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_k9DDUQ": {
          "type": "question",
          "settings": {
            "question": "How does MagShield attach to my phone?",
            "answer": "<p>Each MagShield features a built-in magnetic attachment system that securely connects to MagSafe-compatible iPhones and magnetic phone cases. Simply place the MagShield on the back of your device and it attaches instantly<br\/><\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_miCXWW": {
          "type": "question",
          "settings": {
            "question": "Will MagShield work with all phones?",
            "answer": "<p>MagShield works best with MagSafe-compatible iPhones and magnetic phone cases. For non-magnetic devices, a compatible magnetic case or ring may be required<br\/><\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_RtJgEN": {
          "type": "question",
          "settings": {
            "question": "Can I switch between different MagShields?",
            "answer": "<p>Yes.<br\/>You can easily remove one MagShield and replace it with another in seconds<br\/><\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_VG3k3L": {
          "type": "question",
          "settings": {
            "question": "What makes MagShield different from regular phone accessories?",
            "answer": "<p>MagShield is not a sticker, skin, phone case, or pop grip.<br\/>It is a premium stainless steel football collectible designed specifically for your phone, creating an entirely new way to collect, display, and carry sporting icons<br\/><\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_k9FUyg": {
          "type": "question",
          "settings": {
            "question": "Is this a collectible or an accessory?",
            "answer": "<p>Both. MagShield is designed as a collectible and an everyday carry item, combining premium craftsmanship with practical magnetic attachment<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        }
      },
