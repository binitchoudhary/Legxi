    "text_with_media_9j76fT": {
      "type": "text-with-media",
      "blocks": {
        "heading_YwVHJJ": {
          "type": "heading",
          "settings": {
            "text": "What is a MagShield?",
            "heading_tag": "h2",
            "position": "top_left",
            "highlight_effect": "default",
            "highlight_accent_color": "",
            "highlight_text_color": ""
          }
        },
        "richtext_jGXzA3": {
          "type": "richtext",
          "settings": {
            "text": "<p>MagShield is a premium metallic football collectible designed specifically for your iPhone.<\/p><p>Unlike traditional memorabilia that stays on a shelf, MagShield becomes part of your everyday carry. Built using stainless steel and magnetic technology, it securely attaches to compatible devices while showcasing your favourite players and teams<br\/><\/p>",
            "position": "bottom_left"
          }
        }
      },
      "block_order": [
        "heading_YwVHJJ",
        "richtext_jGXzA3"
      ],
