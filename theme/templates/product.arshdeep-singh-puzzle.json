    "faq_U7EXL8": {
      "type": "faq",
      "blocks": {
        "question_fzMaty": {
          "type": "question",
          "settings": {
            "question": "Is this puzzle hand signed by arshdeep singh ?",
            "answer": "<p>Out of 494 editions, 5 <strong>puzzles are personally hand-signed by Arshdeep Singh<\/strong>.These are <strong>randomly distributed<\/strong> across all orders. Will you be the lucky one ? <br\/><\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_4DxtmC": {
          "type": "question",
          "settings": {
            "question": "Can I choose to buy a signed edition?",
            "answer": "<p>No. Signed editions are <strong>not sold separately<\/strong>.<br\/>Every order has an equal chance of receiving one.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_zn6QHg": {
          "type": "question",
          "settings": {
            "question": "How many pieces does the puzzle have?",
            "answer": "<p>Each edition contains 494<strong> precision-cut pieces<\/strong> with a premium soft-touch finish.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_bc4eUW": {
          "type": "question",
          "settings": {
            "question": "How many editions are available?",
            "answer": "<p>This drop is <strong>limited to 494 editions only<\/strong>.<br\/>Once sold out, it will <strong>not be restocked<\/strong>.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_iQdBDk": {
          "type": "question",
          "settings": {
            "question": "What exactly do I receive?",
            "answer": "<p>You receive a <strong>494-piece collectible puzzle<\/strong> along with an <strong>adhesive backing sheet<\/strong> to convert it into a display-ready poster. A few collectors will receive a personally hand-signed edition, randomly distributed.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_gTNiAx": {
          "type": "question",
          "settings": {
            "question": "What is the final size after completion?",
            "answer": "<p>The completed puzzle measures <strong>15.3 × 21.6 inches<\/strong>.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_VfPxee": {
          "type": "question",
          "settings": {
            "question": "What is the delivery timeline?",
            "answer": "<p>India: 7–10 days. International: up to 18 days.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_P69VeC": {
          "type": "question",
          "settings": {
            "question": "What is the Return & Refund Policy?",
            "answer": "<p>Due to the <strong>limited and collectible nature<\/strong> of each edition, Replacements are only provided in case of <strong>manufacturing defects or transit damage<\/strong>, subject to verification.<\/p>",
