    "faq_U7EXL8": {
      "type": "faq",
      "blocks": {
        "question_fzMaty": {
          "type": "question",
          "settings": {
            "question": "Is this officially associated with the 2007 T20 team?",
            "answer": "<p>This is an independently designed LEGXI collectible, created as a tribute to India’s 2007 T20 World Cup victory.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_4DxtmC": {
          "type": "question",
          "settings": {
            "question": "<strong>Is this a limited edition <\/strong>",
            "answer": "<p>Yes. Only <strong>2007 editions will ever exist worldwide.<\/strong> <\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_zn6QHg": {
          "type": "question",
          "settings": {
            "question": "How is authenticity verified?",
            "answer": "<p> Each artwork carries a unique serial number out of 2007, secured with a premium hologram and QR-linked digital ownership record for collector verification.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_MHCCNJ": {
          "type": "question",
          "settings": {
            "question": "What is size of the Artwork?",
            "answer": "<p>The artwork measures <strong>19 × 27 inches<\/strong>, designed for a strong and refined wall presence.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_gTNiAx": {
          "type": "question",
          "settings": {
            "question": "What print and framing standards are used?",
            "answer": "<p>The artwork is produced using museum-grade metal sheet printing with embossed detailing having 3D touch, paired with premium gallery framing built for preservation.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_VfPxee": {
          "type": "question",
          "settings": {
            "question": "What is the delivery timeline?",
            "answer": "<p>Orders are dispatched within 3 to 4 days. Delivery across India is completed within 10 days, while international deliveries are completed within 18 days.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_M33Rjj": {
          "type": "question",
          "settings": {
            "question": "Does this qualify as a long-term collectible?",
            "answer": "<p>Fixed edition architecture combined with historic significance and transformational impact forms a strong foundation for enduring collectible value.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_P69VeC": {
          "type": "question",
          "settings": {
            "question": "What is Return & Refund Policy?",
            "answer": "<p>Each artwork is individually crafted and authenticated. Returns are eligible only in cases of verified manufacturing defects or transit-related damage. Dedicated support is provided for such concerns.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        }
      },
