    "faq_U7EXL8": {
      "type": "faq",
      "blocks": {
        "question_fzMaty": {
          "type": "question",
          "settings": {
            "question": "How do I know this collectible is authentic?",
            "answer": "<p>Every LEGXI Limited Edition Arshdeep Singh Signed Ball is 100% authentic. LEGXI is a certified collectible brand, co-invested by Indian cricketer Arshdeep Singh himself - ensuring credibility and trust. Each ball is personally hand-signed by Arshdeep Singh and comes with a Certificate of Authenticity, verifying its signature, edition number, and collectible value.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_zn6QHg": {
          "type": "question",
          "settings": {
            "question": "Is the frame and wooden base included?",
            "answer": "<p>Yes. Every collectible comes encased in a crystal-clear museum-grade glass frame and poised on a premium hand-finished wooden base, designed to preserve and showcase your collectible with distinction.<\/p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_MHCCNJ": {
