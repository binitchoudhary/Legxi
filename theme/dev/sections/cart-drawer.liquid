<script>
(function() {
  /* ── state ── */
  var lgxHmProducts   = null; // [{pid, title, vid, price, img}]
  var lgxHmProductIds = [];

  /* ── lgxHmAdd exposed globally for inline onclick handlers ── */
  window.lgxHmAdd = function(vid, btn) {
  if (btn.disabled) return;
  btn.disabled = true;
  var orig = btn.textContent;
  btn.textContent = '···';
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ items: [{ id: vid, quantity: 1 }] })
  })
  .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
  .then(function() { return fetch('/cart.js'); })
  .then(function(r) { return r.json(); })
  .then(function(cart) {
    document.documentElement.dispatchEvent(new CustomEvent('cart:change', {
      bubbles: true, detail: { cart: cart }
    }));
    document.dispatchEvent(new CustomEvent('cart:refresh'));
  })
  .catch(function() {
    btn.disabled = false;
    btn.textContent = orig;
  });
  };

  /* ── helpers ── */
  function resizeImg(src) {
    return src ? src.replace(/(\.\w{3,4})(\?|$)/, '_160x160$1$2') : '';
  }

  /* ── core: re-render suggestions based ONLY on Heritage Mini items ── */
  function lgxHmRefresh(cartItems) {
    var root = document.getElementById('lgx-hm-suggest-root');
    if (!root || !lgxHmProducts) return;
    var row = document.getElementById('lgx-hm-suggest-row');
    if (!row) return;

    root.setAttribute('data-lgx-ready', '1');

    // Filter to Heritage Mini items only — all other cart products are ignored entirely
    var hmItems    = cartItems.filter(function(item) {
      return lgxHmProductIds.indexOf(item.product_id) !== -1;
    });
    var hmCount    = hmItems.reduce(function(n, item) { return n + item.quantity; }, 0);
    var hmCartPids = hmItems.map(function(item) { return item.product_id; });

    if (hmCount >= 3) {
      root.style.display = 'none';
      return;
    }

    // Suggest HM products not already in cart
    var available = lgxHmProducts
      .filter(function(p) { return hmCartPids.indexOf(p.pid) === -1; })
      .slice(0, 3);

    row.innerHTML = available.map(function(c) {
      return '<div class="lgx-hm-scard">' +
        '<div class="lgx-hm-scard__img">' +
          (c.img ? '<img src="' + c.img + '" alt="" loading="lazy" width="80" height="80">' : '') +
        '</div>' +
        '<p class="lgx-hm-scard__name">' + c.title + '</p>' +
        '<p class="lgx-hm-scard__price">₹' + Math.round(c.price).toLocaleString('en-IN') + '</p>' +
        '<button type="button" class="lgx-hm-scard__add" onclick="lgxHmAdd(' + c.vid + ',this)">Add</button>' +
      '</div>';
    }).join('');

    root.style.display = available.length > 0 ? '' : 'none';
  }

  /* ── detect a freshly-rendered suggest-root (no data-lgx-ready) after AJAX section re-render ── */
  function lgxHmCheckNew() {
    var root = document.getElementById('lgx-hm-suggest-root');
    if (!root || root.getAttribute('data-lgx-ready')) return;
    root.setAttribute('data-lgx-ready', '1');

    function doRefresh() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) { lgxHmRefresh(cart.items || []); })
        .catch(function() {});
    }

    if (!lgxHmProducts) {
      // Products not cached yet (page loaded with 0 HMs) — fetch now
      var coll = root.getAttribute('data-hm-collection') || 'legxi-heritage-minis';
      fetch('/collections/' + coll + '/products.json?limit=10')
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(d) { if (d) parseCollection(d); })
        .then(doRefresh)
        .catch(doRefresh);
    } else {
      doRefresh();
    }
  }

  /* ── listen for cart:change (fired by lgxHmAdd and theme quantity selectors) ── */
  document.documentElement.addEventListener('cart:change', function(e) {
    var cart = e.detail && e.detail.cart;
    if (!cart) return;
    if (lgxHmProducts) {
      setTimeout(function() { lgxHmRefresh(cart.items || []); }, 0);
    } else {
      // Products not yet loaded (first HM added to an empty cart) —
      // call lgxHmCheckNew after current call stack clears so the theme's
      // synchronous replaceChildren has already inserted the new DOM.
      setTimeout(lgxHmCheckNew, 0);
    }
  });

  /* ── MutationObserver: catches AJAX section re-renders that don't fire cart:change ── */
  function setupObserver() {
    var target = document.querySelector('.shopify-section--cart-drawer') || document.body;
    new MutationObserver(function() {
      clearTimeout(window._lgxHmObTimer);
      window._lgxHmObTimer = setTimeout(lgxHmCheckNew, 40);
    }).observe(target, { childList: true, subtree: true });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupObserver);
  } else {
    setupObserver();
  }

  /* ── init: fetch collection products, then initial cart ── */
  var initRoot = document.getElementById('lgx-hm-suggest-root');
  if (!initRoot) return;

  var hmCollection = initRoot.getAttribute('data-hm-collection') || 'legxi-heritage-minis';

  function parseCollection(d) {
    lgxHmProducts = (d.products || []).map(function(p) {
      var v = p.variants && p.variants[0];
      if (!v) return null;
      return { pid: p.id, title: p.title, vid: v.id, price: parseFloat(v.price), img: resizeImg(p.images && p.images[0] && p.images[0].src) };
    }).filter(Boolean);
    lgxHmProductIds = lgxHmProducts.map(function(p) { return p.pid; });
  }

  fetch('/collections/' + hmCollection + '/products.json?limit=10')
    .then(function(r) {
      if (!r.ok) throw new Error('404');
      return r.json().then(parseCollection);
    })
    .catch(function() {
      // Fallback: predictive search + per-product fetch
      return fetch('/search/suggest.json?q=Heritage+Minis&type=product&resources[type]=product&resources[limit]=10')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var hits = ((data.resources || {}).results || {}).products || [];
          return Promise.all(hits.filter(function(p) { return p.handle; }).slice(0, 6).map(function(p) {
            return fetch('/products/' + p.handle + '.json').then(function(r) { return r.json(); }).catch(function() { return null; });
          }));
        })
        .then(function(results) {
          lgxHmProducts = (results || []).filter(Boolean).map(function(d) {
            var prod = d && d.product;
            var v = prod && prod.variants && prod.variants[0];
            if (!v) return null;
            return { pid: prod.id, title: prod.title, vid: v.id, price: parseFloat(v.price), img: resizeImg(prod.images && prod.images[0] && prod.images[0].src) };
          }).filter(Boolean);
          lgxHmProductIds = lgxHmProducts.map(function(p) { return p.pid; });
        })
        .catch(function() {});
    })
    .then(function() { return fetch('/cart.js').then(function(r) { return r.json(); }); })
    .then(function(cart) { lgxHmRefresh(cart.items || []); })
    .catch(function() {});
})();
</script>

