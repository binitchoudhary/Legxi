{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PRODUCT STICKY ADD TO CART
----------------------------------------------------------------------------------------------------------------------

This component is used to render the sticky add to cart.

********************************************
Supported variables
********************************************

* product: the product to render
* product_form_id: the main product form
* section: the section is implicitly available. Here, the section is always a "product" template section, so you can
           access all the information from the section
{%- endcomment -%}

{%- assign _no_atc_suffixes = 'argentine-icons-24k,trinity-set,campeones-world-cup-2022,la-scaloneta-2026-edition' | split: ',' -%}
{%- unless _no_atc_suffixes contains product.template_suffix -%}
{%- if product.available and section.settings.show_sticky_add_to_cart -%}
  <product-sticky-add-to-cart class="product-sticky-add-to-cart color-scheme color-scheme--{{ settings.default_color_scheme.id }}" main-product-form="{{ product_form_id }}">
    <product-rerender id="product-sticky-add-to-cart-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}">
      {%- liquid
        comment
          A URL's ?variant= parameter is honored even when that variant is sold out. Fall back
          to an available SYSTEM ASSIGNED (AUTO) variant that matches the requested one on
          every other option (e.g. framing style, when present), so we land on the correct
          live default without silently switching the customer to a different option value.
          Works for both single-option (edition-only) and multi-option (framing + edition)
          products.
        endcomment
        assign current_variant = product.selected_or_first_available_variant
        if current_variant.available == false
          assign requested_options = current_variant.options
          assign available_variants = product.variants | where: 'available', true
          for v in available_variants
            assign is_match = true
            for opt_val in v.options
              assign idx = forloop.index0
              assign requested_val = requested_options[idx]
              if opt_val != requested_val and opt_val != 'SYSTEM ASSIGNED (AUTO)'
                assign is_match = false
              endif
            endfor
            if is_match and v.title contains 'SYSTEM ASSIGNED (AUTO)'
              assign current_variant = v
              break
            endif
          endfor
        endif
      -%}
      <div class="h-stack gap-6 sm-max:hidden">
        {%- assign image = current_variant.featured_media | default: product.featured_media -%}

        {%- if image != blank -%}
          {{- image | image_url: width: image.width | image_tag: loading: 'lazy', widths: '70,140,210,280', class: 'constrained-image', style: '--image-max-width: 70px' -}}
        {%- endif -%}

        <div class="v-stack gap-0.5">
          <span class="subheading">{{ product.title }}</span>

          {%- unless product.has_only_default_variant -%}
            <span class="subheading text-subdued">{{ current_variant.title }}</span>
          {%- endunless -%}

          {%- render 'price-list', variant: current_variant, context: 'line_item' -%}
        </div>
      </div>

      {%- liquid
        if current_variant.available
          assign button_label = 'product.general.add_to_cart_button' | t
          assign disabled = false
        else
          assign button_label = 'product.general.sold_out_button' | t
          assign disabled = true
        endif

        render 'button', type: 'submit', form: product_form_id, content: button_label, disabled: disabled, style: 'outline', class: 'sm-max:hidden'
        render 'button', type: 'submit', form: product_form_id, content: button_label, disabled: disabled, style: 'solid', class: 'sm:hidden'
      -%}
    </product-rerender>
  </product-sticky-add-to-cart>
{%- endif -%}
{%- endunless -%}