    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "color",
      "id": "enquire_button_bg",
      "label": "Enquire background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "enquire_button_text",
      "label": "Enquire text",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "enquire_button_hover_bg",
      "label": "Enquire hover background",
