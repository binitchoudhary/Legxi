{% doc %}
  @prompt
    3 slides that shows details on hover
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hover-slides-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-hover-slides-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.slide_gap }}px;
  }

  .ai-hover-slide-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    cursor: pointer;
  }

  .ai-hover-slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-hover-slide-{{ ai_gen_id }}:hover .ai-hover-slide-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-hover-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hover-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-hover-slide-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: {{ block.settings.overlay_color }};
    opacity: 0;
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 24px;
    text-align: center;
  }

  .ai-hover-slide-{{ ai_gen_id }}:hover .ai-hover-slide-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-hover-slide-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 12px;
    transform: translateY(20px);
    transition: transform 0.4s ease 0.1s;
  }

  .ai-hover-slide-{{ ai_gen_id }}:hover .ai-hover-slide-title-{{ ai_gen_id }} {
    transform: translateY(0);
  }

  .ai-hover-slide-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    margin: 0;
    transform: translateY(20px);
    transition: transform 0.4s ease 0.2s;
  }

  .ai-hover-slide-{{ ai_gen_id }}:hover .ai-hover-slide-description-{{ ai_gen_id }} {
    transform: translateY(0);
  }

  .ai-hover-slide-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-hover-slides-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.slide_gap | times: 0.75 }}px;
    }

    .ai-hover-slide-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-hover-slide-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<hover-slides-{{ ai_gen_id }}
  class="ai-hover-slides-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hover-slides-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign title_key = 'slide_' | append: i | append: '_title'
        assign description_key = 'slide_' | append: i | append: '_description'
        assign link_key = 'slide_' | append: i | append: '_link'

        assign slide_image = block.settings[image_key]
        assign slide_title = block.settings[title_key]
        assign slide_description = block.settings[description_key]
        assign slide_link = block.settings[link_key]
      %}

      {% if slide_link != blank %}
        <a href="{{ slide_link }}" class="ai-hover-slide-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-hover-slide-{{ ai_gen_id }}">
      {% endif %}

        {% if slide_image %}
          <img
            src="{{ slide_image | image_url: width: 800 }}"
            alt="{{ slide_image.alt | escape }}"
            loading="lazy"
            width="{{ slide_image.width }}"
            height="{{ slide_image.height }}"
            class="ai-hover-slide-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-hover-slide-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-hover-slide-empty-state-{{ ai_gen_id }}">
              Add image for slide {{ i }}
            </div>
          </div>
        {% endif %}

        <div class="ai-hover-slide-overlay-{{ ai_gen_id }}">
          {% if slide_title != blank %}
            <h3 class="ai-hover-slide-title-{{ ai_gen_id }}">{{ slide_title }}</h3>
          {% endif %}
          {% if slide_description != blank %}
            <p class="ai-hover-slide-description-{{ ai_gen_id }}">{{ slide_description }}</p>
          {% endif %}
        </div>

      {% if slide_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</hover-slides-{{ ai_gen_id }}>

<script>
  (function() {
    class HoverSlides{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-hover-slide-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.slides.forEach((slide) => {
          if (!slide.hasAttribute('href')) {
            slide.setAttribute('tabindex', '0');
            slide.setAttribute('role', 'article');
          }
        });
      }
    }

    customElements.define('hover-slides-{{ ai_gen_id }}', HoverSlides{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hover detail slides",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Gap between slides",
      "min": 0,
