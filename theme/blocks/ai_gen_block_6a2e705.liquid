    },
    {
      "type": "textarea",
      "id": "slide_1_description",
      "label": "Description",
      "default": "Discover our exclusive limited-edition pieces"
    },
    {
      "type": "url",
      "id": "slide_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Slide 2"
    },
    {
      "type": "image_picker",
      "id": "slide_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "slide_2_title",
      "label": "Title",
      "default": "Signed Memorabilia"
    },
    {
      "type": "textarea",
      "id": "slide_2_description",
      "label": "Description",
      "default": "Authentic autographed collectibles from legends"
    },
    {
      "type": "url",
      "id": "slide_2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Slide 3"
    },
    {
      "type": "image_picker",
      "id": "slide_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "slide_3_title",
      "label": "Title",
      "default": "Rare Finds"
